{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "blisspathtours",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-30",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "blisspathtours.com",
      "custom_domain": true
    },
    {
      "pattern": "www.blisspathtours.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "vars": {
    "INQUIRY_RECIPIENT_EMAIL": "blisspathtourssafaris@gmail.com"
  }
}
