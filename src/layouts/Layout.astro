---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishDate?: string;
  author?: string;
  keywords?: string[];
  canonicalUrl?: string;
  articleJsonLd?: Record<string, any>;
}

const {
  title = "Bliss Path Tours & Safaris | Luxury African Safaris & Wilderness Journeys",
  description = "Craft bespoke African safaris and wildlife expeditions with Bliss Path Tours & Safaris. Experience the Masai Mara Great Migration, Amboseli elephants, Serengeti plains, and Diani Beach.",
  image = "/images/logo.jpg",
  type = "website",
  publishDate,
  author = "Bliss Path Safari Naturalists",
  keywords = ["African safaris", "Kenya safaris", "Tanzania safaris", "Uganda gorilla trekking", "Great Migration 2026"],
  canonicalUrl = Astro.url.href,
  articleJsonLd
} = Astro.props;

const siteUrl = Astro.site ? Astro.site.toString() : "https://blisspathtours.com";
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}${image}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    
    <!-- Multi-Resolution Icons for Chrome Tabs, Search Results & Mobile -->
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="48x48" href="/favicon-48x48.png" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="apple-touch-icon" sizes="152x152" href="/apple-touch-icon-152x152.png" />
    <link rel="apple-touch-icon" sizes="120x120" href="/apple-touch-icon-120x120.png" />
    <meta name="msapplication-TileImage" content="/mstile-150x150.png" />
    <meta name="msapplication-TileColor" content="#094423" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#094423" />
    
    <link rel="canonical" href={canonicalUrl} />
    <meta name="generator" content={Astro.generator} />
    
    <!-- Primary SEO Metadata -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(", ")} />
    <meta name="author" content={author} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={fullImageUrl} />
    <meta property="og:site_name" content="Bliss Path Tours & Safaris" />
    <meta property="og:locale" content="en_US" />

    {type === "article" && publishDate && (
      <meta property="article:published_time" content={publishDate} />
      <meta property="article:author" content={author} />
      <meta property="article:section" content="African Safari Travel Guides" />
    )}

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={fullImageUrl} />

    <!-- Google Fonts: Playfair Display + Plus Jakarta Sans + Caveat -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@600;700&family=Playfair+Display:ital,wght@0,500;0,600;0,700;1,600&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: TravelAgency Base Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "TravelAgency",
      "name": "Bliss Path Tours & Safaris",
      "url": "https://blisspathtours.com",
      "logo": "https://blisspathtours.com/images/logo.jpg",
      "image": "https://blisspathtours.com/images/logo.jpg",
      "description": "Premier East African tour operator crafting bespoke private safaris across Kenya, Tanzania, and Uganda.",
      "priceRange": "$$$",
      "currenciesAccepted": "USD, EUR, GBP, KES",
      "telephone": "+254741319503",
      "email": "info@blisspathtours.com",
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Off outering road, Next to fedha Quickmart Ongata Rongai",
        "addressLocality": "Nairobi",
        "addressCountry": "Kenya"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": "-1.2921",
        "longitude": "36.8219"
      }
    })} />

    <!-- Article Specific Structured Data (Schema.org BlogPosting & FAQPage) -->
    {articleJsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
    )}
  </head>
  <body class="bg-[#FDFBF7] text-[#121814] antialiased selection:bg-[#FFAE19] selection:text-[#094423]">
    <slot />
  </body>
</html>
