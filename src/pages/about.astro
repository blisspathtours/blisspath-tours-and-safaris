---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="About Us | Bliss Path Tours & Safaris - Our Story & Values"
  description="Learn about Bliss Path Tours & Safaris. Native Kenyan safari outfitter dedicated to ethical wildlife conservation, custom 4x4 Land Cruiser safaris, and unforgettable African journeys."
>
  <Header />

  <main class="bg-[#FDFBF7] min-h-screen">
    
    <!-- Hero Banner -->
    <div class="relative py-24 bg-gradient-to-r from-[#094423] via-[#0F6B38] to-[#121814] text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 text-[#FFAE19] text-xs font-bold uppercase tracking-wider mb-4 border border-white/20">
          <span>Born In The Savannah</span>
        </div>
        <h1 class="text-4xl sm:text-6xl font-bold font-serif-luxury tracking-tight leading-tight">
          The Story Behind <br />
          <span class="text-[#FFAE19] font-script-bliss text-5xl sm:text-7xl">Bliss Path Safaris</span>
        </h1>
        <p class="mt-4 text-base sm:text-xl text-slate-200 font-light max-w-2xl mx-auto leading-relaxed">
          Founded on a deep love for Africa’s untamed wilderness, authentic native knowledge, and a belief that every journey should touch the soul.
        </p>
      </div>
    </div>

    <!-- Origin Story Section -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <div class="lg:col-span-6 space-y-6 text-gray-700 leading-relaxed font-light text-base sm:text-lg">
          <span class="text-xs uppercase tracking-widest text-[#E86A17] font-bold block">
            Our Foundation
          </span>
          <h2 class="text-3xl sm:text-4xl font-bold font-serif-luxury text-[#1E2621]">
            More Than A Tour Company — <br />
            <span class="text-[#0F6B38]">A Lifelong Passion for Africa</span>
          </h2>
          <p>
            Bliss Path Tours & Safaris was created with a clear mission: to move away from rigid, mass-market tourist conveyer belts and return the African safari to what it was always meant to be — an intimate, soul-stirring expedition into the raw wonder of nature.
          </p>
          <p>
            Growing up on the edge of Kenya’s legendary wildlife ecosystems, our founders and guides spent their youth listening to the evening roars of lions and tracking elephants through the acacia bush. We know the rhythm of the rains, the secret crossing points of the Mara River, and the quiet kopjes where cheetah cubs play at sunrise.
          </p>
          <div class="p-6 rounded-2xl bg-white border-l-4 border-[#FFAE19] shadow-sm italic text-gray-800 font-normal">
            "We named our company Bliss Path because we believe that standing beneath an acacia tree as the sun sets over the African horizon is one of the purest feelings of bliss a human can experience."
          </div>
        </div>

        <div class="lg:col-span-6 relative">
          <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white">
            <img
              src="/images/logo.jpg"
              alt="Bliss Path Tours & Safaris Official Logo"
              class="w-full max-w-md mx-auto object-contain p-6 bg-white"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Core Pillars Grid -->
    <div class="bg-white py-20 border-y border-gray-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16">
          <span class="text-xs uppercase tracking-wider text-[#0F6B38] font-bold block mb-2">Our Operating Standards</span>
          <h2 class="text-3xl sm:text-4xl font-bold font-serif-luxury text-[#1E2621]">
            What Defines A Bliss Path Journey
          </h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          
          <div class="p-8 rounded-3xl bg-[#FDFBF7] border border-gray-200/80 shadow-xs hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-2xl bg-[#0F6B38]/10 text-[#0F6B38] flex items-center justify-center font-bold text-xl mb-6">
              1
            </div>
            <h3 class="text-xl font-bold text-[#1E2621] mb-3">Custom 4x4 Fleet Only</h3>
            <p class="text-sm text-gray-600 leading-relaxed font-light">
              We never use closed minivans. Every traveler rides in our custom-built Toyota Land Cruisers with 360° pop-up photography hatches, high suspension, and guaranteed window seats.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#FDFBF7] border border-gray-200/80 shadow-xs hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-2xl bg-[#FFAE19]/20 text-[#094423] flex items-center justify-center font-bold text-xl mb-6">
              2
            </div>
            <h3 class="text-xl font-bold text-[#1E2621] mb-3">Elite Native Naturalists</h3>
            <p class="text-sm text-gray-600 leading-relaxed font-light">
              Our guides are certified by the Kenya Professional Safari Guides Association (KPSGA). They are master trackers, historians, birders, and compassionate hosts.
            </p>
          </div>

          <div class="p-8 rounded-3xl bg-[#FDFBF7] border border-gray-200/80 shadow-xs hover:shadow-lg transition-all">
            <div class="w-12 h-12 rounded-2xl bg-[#E86A17]/10 text-[#E86A17] flex items-center justify-center font-bold text-xl mb-6">
              3
            </div>
            <h3 class="text-xl font-bold text-[#1E2621] mb-3">Conservation First</h3>
            <p class="text-sm text-gray-600 leading-relaxed font-light">
              A portion of every safari directly supports indigenous community welfare and wildlife conservation, keeping the plains wild for generations to come.
            </p>
          </div>

        </div>
      </div>
    </div>

    <!-- CTA Section -->
    <div class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="bg-gradient-to-r from-[#094423] to-[#0F6B38] rounded-3xl p-10 sm:p-14 text-white shadow-2xl">
        <h2 class="text-3xl sm:text-4xl font-bold font-serif-luxury">
          Ready to Begin Your African Journey?
        </h2>
        <p class="mt-3 text-slate-200 max-w-xl mx-auto text-base">
          Let our native safari designers craft a journey tailored around your dreams, timing, and budget.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-4">
          <a
            href="/#inquiry"
            class="px-8 py-3.5 rounded-full text-sm font-bold bg-[#FFAE19] text-[#094423] hover:bg-white transition-all shadow-md active:scale-95"
          >
            Plan Your Safari
          </a>
          <a
            href="https://wa.me/254741319503"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full text-sm font-bold bg-[#25D366] text-white hover:brightness-105 transition-all shadow-md active:scale-95 flex items-center gap-2"
          >
            <span>Chat on WhatsApp</span>
          </a>
        </div>
      </div>
    </div>

  </main>

  <Footer />
</Layout>
