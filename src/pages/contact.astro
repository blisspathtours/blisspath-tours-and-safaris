---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const faqs = [
  {
    q: "When is the best time to visit Kenya & Tanzania for a safari?",
    a: "Safaris in East Africa are spectacular year-round! For the famous Great Migration river crossings in the Masai Mara, visit between July and October. For newborn calves in the southern Serengeti, January through March is prime. If you prefer lush landscapes, fewer vehicles, and exceptional lodge rates, the Green Season (November–December and April–May) is fantastic."
  },
  {
    q: "Do I need a visa to travel to Kenya?",
    a: "Kenya has transitioned to a streamlined Electronic Travel Authorization (eTA) system. International travelers must apply online at least 3 days prior to departure. Our team provides complete step-by-step guidance for completing your eTA smoothly."
  },
  {
    q: "What type of vehicle do you use on safari?",
    a: "We exclusively use custom-outfitted 4x4 Toyota Land Cruisers with 360° pop-up photography roofs, high clearance, long-range fuel tanks, UHF radio communication, power inverter charging ports for cameras/phones, and onboard refrigerator cool boxes with chilled drinking water. Every guest is guaranteed a window seat."
  },
  {
    q: "What should I pack for an African safari?",
    a: "Pack lightweight, breathable clothing in neutral earth tones (khaki, beige, olive green, tan). Avoid bright blues and blacks which can attract tsetse flies. Essential items include: a warm fleece or windbreaker for crisp morning/night game drives, wide-brim sun hat, sunglasses, sunscreen, high-SPF lip balm, comfortable walking shoes, insect repellent, and a good camera with a telephoto zoom lens (200mm+ recommended)."
  },
  {
    q: "What are your deposit and cancellation policies?",
    a: "We require a 30% deposit upon booking to secure your luxury lodge reservations and national park permits. The remaining balance is due 30 days prior to safari departure. Should unforeseen events arise, we offer flexible rescheduling within 12 months with zero administrative fees."
  },
  {
    q: "Are your safaris family-friendly for children?",
    a: "Yes! We specialize in private family safaris. Having your own dedicated vehicle and private guide means the daily schedule adjusts to your children's pace, with shorter game drives, cultural village visits, animal tracking games, and lodges featuring swimming pools and family suites."
  }
];
---

<Layout
  title="Contact Us & Safari FAQ | Bliss Path Tours & Safaris"
  description="Get in touch with the Bliss Path safari team in Nairobi, Kenya. View our 24/7 WhatsApp, emergency phone, office address, and read answers to common safari planning questions."
>
  <Header />

  <main class="bg-[#FDFBF7] min-h-screen">
    
    <!-- Hero Header -->
    <div class="relative py-20 bg-gradient-to-r from-[#094423] via-[#0F6B38] to-[#121814] text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-3 py-1 rounded-full bg-[#FFAE19] text-[#094423] text-xs font-bold uppercase tracking-wider mb-4">
          Direct Safari Concierge
        </span>
        <h1 class="text-4xl sm:text-6xl font-bold font-serif-luxury tracking-tight">
          Contact Our Safari Desk
        </h1>
        <p class="mt-3 text-base sm:text-xl text-slate-200 font-light max-w-xl mx-auto">
          We are ready to answer your questions, customize your dream route, or assist with flights and accommodations.
        </p>
      </div>
    </div>

    <!-- Contact Info Cards -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-10 relative z-20">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        
        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-xl text-center flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-[#25D366]/10 text-[#25D366] flex items-center justify-center mb-4">
            <svg class="w-7 h-7 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 2a10.024 10.024 0 00-8.672 15.067L2 22l5.06-1.328A10.034 10.034 0 1012.031 2zm0 18.232c-1.802 0-3.513-.482-5.008-1.378l-.359-.214-3.003.788.802-2.928-.235-.374a8.214 8.214 0 117.803 4.106zm4.502-6.147c-.247-.123-1.463-.722-1.689-.804-.227-.083-.392-.123-.558.123s-.64.804-.784.969c-.144.165-.289.186-.536.062-.248-.124-1.046-.386-1.993-1.23-.737-.658-1.234-1.47-1.379-1.718-.144-.247-.015-.38.109-.504.111-.111.248-.289.371-.433.124-.144.165-.247.247-.412.083-.165.041-.31-.02-.433s-.558-1.344-.764-1.84c-.2-.485-.404-.42-.558-.427l-.475-.008c-.165 0-.433.062-.66.31-.227.247-.866.846-.866 2.064s.887 2.394 1.01 2.56c.124.165 1.745 2.664 4.227 3.737.59.256 1.052.408 1.411.523.593.188 1.133.162 1.56.098.476-.071 1.463-.598 1.669-1.176.206-.578.206-1.073.144-1.176-.062-.103-.227-.165-.474-.288z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[#1E2621]">WhatsApp 24/7 Support</h3>
          <p class="text-xs text-gray-500 mt-1">Instant messaging with our senior guides</p>
          <a
            href="https://wa.me/254741319503?text=Hello%20Bliss%20Path%20Safaris!"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-4 px-6 py-2.5 rounded-full bg-[#25D366] text-white text-xs font-bold hover:brightness-105 shadow-sm"
          >
            WhatsApp: 0741319503
          </a>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-xl text-center flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-[#0F6B38]/10 text-[#0F6B38] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[#1E2621]">Email Inquiries</h3>
          <p class="text-xs text-gray-500 mt-1">Written proposals & detailed itineraries</p>
          <a
            href="mailto:info@blisspathtours.com"
            class="mt-4 px-6 py-2.5 rounded-full bg-[#0F6B38] text-white text-xs font-bold hover:bg-[#094423] shadow-sm"
          >
            info@blisspathtours.com
          </a>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-gray-100 shadow-xl text-center flex flex-col items-center">
          <div class="w-14 h-14 rounded-2xl bg-[#FFAE19]/20 text-[#094423] flex items-center justify-center mb-4">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-[#1E2621]">Nairobi Office</h3>
          <p class="text-xs text-gray-500 mt-1">Off outering road, Next to fedha Quickmart Ongata Rongai</p>
          <div class="mt-4 flex flex-col gap-1 text-xs font-bold text-[#0F6B38]">
            <a href="tel:0741319503" class="hover:underline">0741319503</a>
            <a href="tel:0721573509" class="hover:underline">0721573509</a>
          </div>
        </div>

      </div>
    </div>

    <!-- FAQ Accordion Section -->
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-24">
      <div class="text-center mb-12">
        <span class="text-xs uppercase tracking-wider text-[#0F6B38] font-bold block mb-2">Safari Planning Intelligence</span>
        <h2 class="text-3xl sm:text-4xl font-bold font-serif-luxury text-[#1E2621]">
          Frequently Asked Questions
        </h2>
        <p class="mt-2 text-sm text-gray-600">
          Everything you need to know before packing your bags for East Africa.
        </p>
      </div>

      <div class="space-y-4">
        {faqs.map((faq, idx) => (
          <details class="group bg-white rounded-2xl border border-gray-200/80 p-6 shadow-xs open:shadow-md transition-all">
            <summary class="flex items-center justify-between cursor-pointer font-bold text-[#1E2621] text-base list-none">
              <span>{faq.q}</span>
              <span class="w-6 h-6 rounded-full bg-[#0F6B38]/10 text-[#0F6B38] flex items-center justify-center text-xs group-open:rotate-180 transition-transform">
                ▼
              </span>
            </summary>
            <p class="mt-4 text-sm text-gray-600 leading-relaxed font-light pt-3 border-t border-gray-100">
              {faq.a}
            </p>
          </details>
        ))}
      </div>
    </div>

  </main>

  <Footer />
</Layout>
