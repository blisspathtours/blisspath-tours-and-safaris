---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import TrustStats from '../components/TrustStats.astro';
import SafariPackages from '../components/SafariPackages.astro';
import Destinations from '../components/Destinations.astro';
import WhyBlissPath from '../components/WhyBlissPath.astro';
import Testimonials from '../components/Testimonials.astro';
import CustomSafariCTA from '../components/CustomSafariCTA.astro';
import Footer from '../components/Footer.astro';
---

<Layout
  title="Bliss Path Tours & Safaris | Luxury African Safaris, Migration & Wildlife Journeys"
  description="Experience the magic of Africa with Bliss Path Tours & Safaris. Bespoke private safaris in Kenya and Tanzania: Masai Mara Great Migration, Amboseli elephants, Serengeti, and pristine Diani Beach."
>
  <Header />
  <main>
    <Hero />
    <TrustStats />
    <SafariPackages />
    <Destinations />
    <WhyBlissPath />
    <Testimonials />
    <CustomSafariCTA />
  </main>
  <Footer />
</Layout>
