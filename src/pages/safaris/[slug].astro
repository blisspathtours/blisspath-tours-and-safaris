---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SAFARI_PACKAGES, type SafariPackage } from '../../data/safaris';

export function getStaticPaths() {
  return SAFARI_PACKAGES.map((pkg) => ({
    params: { slug: pkg.slug },
    props: { pkg }
  }));
}

interface Props {
  pkg: SafariPackage;
}

const { pkg } = Astro.props;

const relatedSafaris = SAFARI_PACKAGES.filter((s) => s.slug !== pkg.slug).slice(0, 3);
const whatsappMessage = encodeURIComponent(
  `Hello Bliss Path Safaris! I am interested in booking the "${pkg.title}" (${pkg.duration}, starting from $${pkg.price}). Could you please send me available dates and customized pricing?`
);
---

<Layout
  title={`${pkg.title} | Bliss Path Tours & Safaris`}
  description={pkg.overview.substring(0, 160)}
>
  <Header />

  <main class="bg-[#FDFBF7] min-h-screen">
    
    <!-- Breadcrumb & Top Bar -->
    <div class="bg-[#094423]/5 border-b border-[#0F6B38]/10 py-3.5">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex items-center justify-between text-xs sm:text-sm">
        <nav class="flex items-center space-x-2 text-gray-500">
          <a href="/" class="hover:text-[#0F6B38] font-medium transition-colors">Home</a>
          <span>/</span>
          <a href="/#safaris" class="hover:text-[#0F6B38] font-medium transition-colors">Safaris</a>
          <span>/</span>
          <span class="text-[#0F6B38] font-semibold truncate max-w-xs sm:max-w-md">{pkg.title}</span>
        </nav>

        <a
          href="https://wa.me/254700000000"
          target="_blank"
          rel="noopener noreferrer"
          class="hidden sm:inline-flex items-center gap-1.5 text-xs font-bold text-[#0F6B38] hover:text-[#E86A17] transition-colors"
        >
          <span>Ask a Guide 24/7</span>
          <span class="text-[#25D366]">● Online</span>
        </a>
      </div>
    </div>

    <!-- Package Title Header Section -->
    <section class="pt-8 pb-6 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-2 mb-3">
        <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#E86A17] text-white shadow-xs">
          {pkg.badge}
        </span>
        <span class="px-3 py-1 rounded-full text-xs font-semibold bg-[#0F6B38]/10 text-[#0F6B38]">
          ⏱ {pkg.duration}
        </span>
        <div class="flex items-center gap-1 text-xs font-bold text-gray-800 bg-white px-2.5 py-1 rounded-full border border-gray-200">
          <span class="text-[#FFAE19]">★</span>
          <span>{pkg.rating}</span>
          <span class="text-gray-400 font-normal">({pkg.reviewsCount} reviews)</span>
        </div>
      </div>

      <h1 class="text-3xl sm:text-5xl font-bold font-serif-luxury text-[#1E2621] tracking-tight leading-tight">
        {pkg.title}
      </h1>
      <p class="mt-2 text-base sm:text-lg text-gray-600 font-light max-w-3xl">
        {pkg.subtitle}
      </p>

      <!-- Key Trip Attributes Bar -->
      <div class="mt-6 grid grid-cols-2 sm:grid-cols-4 gap-4 p-4 rounded-2xl bg-white border border-gray-200/80 shadow-xs text-xs sm:text-sm">
        <div>
          <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold">Duration</span>
          <span class="font-bold text-[#1E2621]">{pkg.duration}</span>
        </div>
        <div>
          <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold">Best Season</span>
          <span class="font-bold text-[#1E2621] truncate block">{pkg.bestTime.split('|')[0]}</span>
        </div>
        <div>
          <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold">Travel Style</span>
          <span class="font-bold text-[#1E2621] capitalize">{pkg.category.replace('-', ' ')}</span>
        </div>
        <div>
          <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold">Starting From</span>
          <span class="font-black text-[#0F6B38] text-base sm:text-lg">${pkg.price} <span class="text-xs font-normal text-gray-500">/ person</span></span>
        </div>
      </div>
    </section>

    <!-- Visual Gallery Grid -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mb-12">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 rounded-3xl overflow-hidden shadow-xl">
        <!-- Main Large Photo -->
        <div class="md:col-span-2 h-80 sm:h-[460px] relative overflow-hidden group">
          <img
            src={pkg.mainImage}
            alt={pkg.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white">
            <span class="text-xs uppercase tracking-widest text-[#FFAE19] font-bold">Featured Itinerary</span>
            <div class="text-xl sm:text-2xl font-bold font-serif-luxury">{pkg.destinations.join(" • ")}</div>
          </div>
        </div>

        <!-- Right Side Photos -->
        <div class="flex flex-col gap-4 h-80 sm:h-[460px]">
          {pkg.gallery.slice(0, 2).map((imgUrl, idx) => (
            <div class="h-1/2 relative overflow-hidden group rounded-2xl">
              <img
                src={imgUrl}
                alt={`${pkg.title} gallery ${idx + 1}`}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              />
              <div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors"></div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Main Content & Sticky Booking Sidebar -->
    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
        
        <!-- Left Column: Detailed Trip Specs (8 cols) -->
        <div class="lg:col-span-8 space-y-12">
          
          <!-- Overview -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1E2621] font-serif-luxury mb-4">
              Safari Overview
            </h2>
            <p class="text-gray-700 leading-relaxed text-base sm:text-lg font-light">
              {pkg.overview}
            </p>

            <div class="mt-6 pt-6 border-t border-gray-100 flex flex-wrap gap-4 text-xs font-semibold text-gray-600">
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#0F6B38]"></span>
                <span>Private 4x4 Land Cruiser</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#0F6B38]"></span>
                <span>All Park Permits Included</span>
              </div>
              <div class="flex items-center gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-[#FFAE19]"></span>
                <span>Flexible Rescheduling</span>
              </div>
            </div>
          </div>

          <!-- Highlights Checklist -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1E2621] font-serif-luxury mb-6">
              Trip Highlights
            </h2>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {pkg.highlights.map((highlight) => (
                <div class="flex items-start gap-3 p-3.5 rounded-2xl bg-[#FDFBF7] border border-gray-100">
                  <div class="w-7 h-7 rounded-full bg-[#0F6B38]/10 text-[#0F6B38] flex items-center justify-center shrink-0 mt-0.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-xs sm:text-sm font-medium text-gray-800 leading-snug">
                    {highlight}
                  </span>
                </div>
              ))}
            </div>
          </div>

          <!-- Day-by-Day Interactive Itinerary Timeline -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
            <div class="flex items-center justify-between mb-8">
              <div>
                <span class="text-xs font-bold text-[#E86A17] uppercase tracking-wider block mb-1">
                  Detailed Route
                </span>
                <h2 class="text-2xl sm:text-3xl font-bold text-[#1E2621] font-serif-luxury">
                  Day-by-Day Itinerary
                </h2>
              </div>
              <span class="text-xs font-semibold px-3 py-1 rounded-full bg-[#0F6B38]/10 text-[#0F6B38]">
                {pkg.durationDays} Days / {pkg.durationDays > 1 ? pkg.durationDays - 1 : 0} Nights
              </span>
            </div>

            <!-- Timeline Container -->
            <div class="relative border-l-2 border-[#0F6B38]/20 ml-4 sm:ml-6 space-y-8 pl-6 sm:pl-8">
              {pkg.itinerary.map((day) => (
                <div class="relative group">
                  <!-- Timeline Node Pin -->
                  <div class="absolute -left-[35px] sm:-left-[43px] top-0 w-8 h-8 sm:w-10 sm:h-10 rounded-full bg-gradient-to-br from-[#0F6B38] to-[#094423] text-white flex items-center justify-center font-bold text-xs sm:text-sm shadow-md ring-4 ring-white">
                    {day.day}
                  </div>

                  <!-- Day Card Content -->
                  <div class="bg-[#FDFBF7] p-5 sm:p-6 rounded-2xl border border-gray-200/70 hover:border-[#FFAE19] transition-colors">
                    <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                      <span class="text-xs uppercase tracking-widest font-bold text-[#E86A17]">
                        Day {day.day} • {day.location}
                      </span>
                      <span class="text-xs font-medium text-gray-500 bg-white px-2.5 py-0.5 rounded-full border border-gray-200">
                        🍽 {day.meals}
                      </span>
                    </div>

                    <h3 class="text-lg sm:text-xl font-bold text-[#1E2621]">
                      {day.title}
                    </h3>

                    <p class="mt-3 text-sm text-gray-700 leading-relaxed font-light">
                      {day.description}
                    </p>

                    <!-- Activities Tags -->
                    <div class="mt-4 pt-3 border-t border-gray-200/50 flex flex-wrap gap-2">
                      {day.activities.map((act) => (
                        <span class="text-[11px] font-semibold px-2.5 py-1 rounded-md bg-white text-[#0F6B38] border border-gray-200/70">
                          ✓ {act}
                        </span>
                      ))}
                    </div>

                    <!-- Accommodation Preview -->
                    <div class="mt-3 text-xs text-gray-500 flex items-center gap-1.5">
                      <svg class="w-3.5 h-3.5 text-[#0F6B38]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
                      </svg>
                      <span class="font-medium text-gray-700">Lodge / Camp:</span>
                      <span>{day.accommodation}</span>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Inclusions vs Exclusions Grid -->
          <div class="bg-white p-6 sm:p-8 rounded-3xl border border-gray-100 shadow-sm">
            <h2 class="text-2xl font-bold text-[#1E2621] font-serif-luxury mb-6">
              What’s Included & Excluded
            </h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              
              <!-- Inclusions -->
              <div class="p-5 rounded-2xl bg-green-50/60 border border-green-200/80">
                <div class="flex items-center gap-2 text-sm font-bold text-[#0F6B38] uppercase tracking-wider mb-4">
                  <svg class="w-5 h-5 text-[#0F6B38]" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                  </svg>
                  <span>Included In Package</span>
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-gray-700">
                  {pkg.inclusions.map((inc) => (
                    <li class="flex items-start gap-2">
                      <span class="text-green-600 font-bold shrink-0 mt-0.5">✓</span>
                      <span>{inc}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Exclusions -->
              <div class="p-5 rounded-2xl bg-amber-50/60 border border-amber-200/80">
                <div class="flex items-center gap-2 text-sm font-bold text-amber-800 uppercase tracking-wider mb-4">
                  <svg class="w-5 h-5 text-amber-700" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"/>
                  </svg>
                  <span>Excluded (Available on Request)</span>
                </div>
                <ul class="space-y-2.5 text-xs sm:text-sm text-gray-700">
                  {pkg.exclusions.map((exc) => (
                    <li class="flex items-start gap-2">
                      <span class="text-amber-700 font-bold shrink-0 mt-0.5">✕</span>
                      <span>{exc}</span>
                    </li>
                  ))}
                </ul>
              </div>

            </div>
          </div>

        </div>

        <!-- Right Column: Sticky Booking / Inquiry Sidebar (4 cols) -->
        <div class="lg:col-span-4 sticky top-24 space-y-6">
          
          <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100 text-gray-800">
            <!-- Price Block -->
            <div class="flex items-baseline justify-between pb-5 border-b border-gray-100">
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-bold">Starting Rate</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-3xl sm:text-4xl font-black text-[#0F6B38]">${pkg.price}</span>
                  <span class="text-xs text-gray-500 font-medium">/ person</span>
                </div>
                <span class="text-[11px] text-gray-400">{pkg.priceNote}</span>
              </div>
              <div class="text-right">
                <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[#FFAE19]/20 text-[#094423]">
                  Best Price Match
                </span>
              </div>
            </div>

            <!-- Instant WhatsApp Booking Button -->
            <div class="mt-6">
              <a
                href={`https://wa.me/254700000000?text=${whatsappMessage}`}
                target="_blank"
                rel="noopener noreferrer"
                class="w-full py-3.5 px-4 rounded-full bg-[#25D366] text-white font-bold text-sm shadow-md hover:brightness-105 active:scale-98 transition-all flex items-center justify-center gap-2"
              >
                <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                  <path d="M12.031 2a10.024 10.024 0 00-8.672 15.067L2 22l5.06-1.328A10.034 10.034 0 1012.031 2zm0 18.232c-1.802 0-3.513-.482-5.008-1.378l-.359-.214-3.003.788.802-2.928-.235-.374a8.214 8.214 0 117.803 4.106zm4.502-6.147c-.247-.123-1.463-.722-1.689-.804-.227-.083-.392-.123-.558.123s-.64.804-.784.969c-.144.165-.289.186-.536.062-.248-.124-1.046-.386-1.993-1.23-.737-.658-1.234-1.47-1.379-1.718-.144-.247-.015-.38.109-.504.111-.111.248-.289.371-.433.124-.144.165-.247.247-.412.083-.165.041-.31-.02-.433s-.558-1.344-.764-1.84c-.2-.485-.404-.42-.558-.427l-.475-.008c-.165 0-.433.062-.66.31-.227.247-.866.846-.866 2.064s.887 2.394 1.01 2.56c.124.165 1.745 2.664 4.227 3.737.59.256 1.052.408 1.411.523.593.188 1.133.162 1.56.098.476-.071 1.463-.598 1.669-1.176.206-.578.206-1.073.144-1.176-.062-.103-.227-.165-.474-.288z"/>
                </svg>
                <span>Book / Inquire via WhatsApp</span>
              </a>
            </div>

            <div class="my-4 flex items-center justify-between text-xs text-gray-400">
              <span class="w-full border-t border-gray-100"></span>
              <span class="px-3 uppercase font-semibold">Or</span>
              <span class="w-full border-t border-gray-100"></span>
            </div>

            <!-- In-Page Quick Quote Form -->
            <form id="sidebar-inquiry-form" class="space-y-3.5">
              <input type="hidden" name="package" value={pkg.title} />

              <div>
                <label class="block text-[11px] font-bold text-gray-700 uppercase tracking-wider mb-1">Your Name</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. John Doe"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-700 uppercase tracking-wider mb-1">Email</label>
                <input
                  type="email"
                  required
                  placeholder="john@example.com"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
                />
              </div>

              <div>
                <label class="block text-[11px] font-bold text-gray-700 uppercase tracking-wider mb-1">Phone / WhatsApp</label>
                <input
                  type="tel"
                  required
                  placeholder="+1 (555) 000-0000"
                  class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
                />
              </div>

              <div class="grid grid-cols-2 gap-2">
                <div>
                  <label class="block text-[11px] font-bold text-gray-700 uppercase tracking-wider mb-1">Travelers</label>
                  <select class="w-full px-2.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50">
                    <option>2 Adults</option>
                    <option>1 Adult</option>
                    <option>Family (2+2)</option>
                    <option>Group (4+)</option>
                  </select>
                </div>
                <div>
                  <label class="block text-[11px] font-bold text-gray-700 uppercase tracking-wider mb-1">Month</label>
                  <select class="w-full px-2.5 py-2.5 rounded-xl border border-gray-200 text-xs focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50">
                    <option>July 2026</option>
                    <option>August 2026</option>
                    <option>Sept 2026</option>
                    <option>Oct 2026</option>
                    <option>Dec 2026</option>
                    <option>Early 2027</option>
                  </select>
                </div>
              </div>

              <button
                type="submit"
                class="w-full py-3.5 rounded-full bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] text-white font-bold text-sm shadow-lg hover:brightness-105 active:scale-98 transition-all"
              >
                Request Custom Quote (Free)
              </button>

              <div id="sidebar-success" class="hidden p-3 rounded-xl bg-green-50 border border-green-200 text-green-800 text-xs text-center font-medium">
                ✓ Quote request received! Our safari director will reach out within 24 hours.
              </div>
            </form>

            <!-- Trust Bullets in Card -->
            <div class="mt-6 pt-5 border-t border-gray-100 space-y-2 text-xs text-gray-600">
              <div class="flex items-center gap-2">
                <span class="text-[#0F6B38] font-bold">✓</span>
                <span>No cancellation penalty up to 30 days</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F6B38] font-bold">✓</span>
                <span>Custom Land Cruiser window seat guaranteed</span>
              </div>
              <div class="flex items-center gap-2">
                <span class="text-[#0F6B38] font-bold">✓</span>
                <span>Direct consultation with native safari guide</span>
              </div>
            </div>

          </div>

          <!-- Need Assistance Card -->
          <div class="p-6 rounded-3xl bg-[#094423] text-white flex items-center gap-4">
            <img
              src="/images/logo.jpg"
              alt="Bliss Path Seal"
              class="w-12 h-12 rounded-full object-cover ring-2 ring-[#FFAE19] shrink-0"
            />
            <div>
              <div class="text-xs uppercase tracking-wider text-[#FFAE19] font-bold">Have Questions?</div>
              <p class="text-xs text-slate-200 mt-0.5">Call our Nairobi safari desk:</p>
              <a href="tel:+254700000000" class="text-sm font-bold text-white hover:text-[#FFAE19]">+254 700 000 000</a>
            </div>
          </div>

        </div>

      </div>
    </section>

    <!-- Related Safaris Section -->
    <section class="bg-white py-16 border-t border-gray-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl sm:text-3xl font-bold font-serif-luxury text-[#1E2621] mb-8">
          You May Also Like
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {relatedSafaris.map((rel) => (
            <a
              href={`/safaris/${rel.slug}`}
              class="group bg-[#FDFBF7] rounded-2xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-200/70 flex flex-col justify-between"
            >
              <div class="relative h-48 overflow-hidden">
                <img
                  src={rel.mainImage}
                  alt={rel.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                />
                <div class="absolute top-3 left-3 bg-[#0F6B38] text-white text-[11px] font-bold px-2.5 py-1 rounded-full">
                  ⏱ {rel.duration}
                </div>
              </div>
              <div class="p-5 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="text-base font-bold text-[#1E2621] group-hover:text-[#0F6B38] transition-colors line-clamp-2">
                    {rel.title}
                  </h3>
                  <p class="text-xs text-gray-500 mt-2 line-clamp-2">
                    {rel.overview}
                  </p>
                </div>
                <div class="mt-4 pt-3 border-t border-gray-200/50 flex items-center justify-between text-xs">
                  <span class="font-bold text-[#0F6B38] text-sm">From ${rel.price}</span>
                  <span class="font-bold text-[#E86A17] group-hover:underline">View Itinerary →</span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

  </main>

  <Footer />
</Layout>

<script>
  const sidebarForm = document.getElementById('sidebar-inquiry-form');
  const sidebarSuccess = document.getElementById('sidebar-success');
  if (sidebarForm && sidebarSuccess) {
    sidebarForm.addEventListener('submit', (e) => {
      e.preventDefault();
      sidebarSuccess.classList.remove('hidden');
      sidebarForm.querySelector('button[type="submit"]')?.setAttribute('disabled', 'true');
      (sidebarForm.querySelector('button[type="submit"]') as HTMLElement)?.classList.add('opacity-50', 'cursor-not-allowed');
    });
  }
</script>
