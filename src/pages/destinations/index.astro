---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { DESTINATIONS } from '../../data/destinations';
---

<Layout
  title="Safari Destinations in Kenya & Tanzania | Bliss Path Tours & Safaris"
  description="Explore the best safari parks and reserves in Kenya and Tanzania: Masai Mara, Serengeti, Amboseli, Diani Beach, Ngorongoro, and Samburu. Filter by country and wildlife highlights."
>
  <Header />

  <main class="bg-[#FDFBF7] min-h-screen">
    
    <!-- Hero Banner -->
    <div class="relative py-20 bg-gradient-to-r from-[#094423] via-[#0F6B38] to-[#121814] text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <span class="inline-block px-3 py-1 rounded-full bg-[#FFAE19] text-[#094423] text-xs font-bold uppercase tracking-wider mb-4">
          Wild Wonderlands
        </span>
        <h1 class="text-2xl sm:text-5xl lg:text-6xl font-bold font-serif-luxury tracking-tight leading-tight px-2">
          East African Safari Destinations
        </h1>
        <p class="mt-3 text-xs sm:text-lg text-slate-200 font-light max-w-2xl mx-auto leading-relaxed px-2">
          Discover the world's most legendary wildlife sanctuaries, from the endless golden plains of the Serengeti to the turquoise shores of Diani Beach.
        </p>
      </div>
    </div>

    <!-- Filter Bar -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 -mt-8 relative z-20">
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-xl border border-gray-100">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 items-center">
          
          <!-- Text Search -->
          <div>
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">Search Destinations</label>
            <div class="relative">
              <input
                id="dest-search-input"
                type="text"
                placeholder="e.g. Mara, Amboseli, Beach..."
                class="w-full pl-9 pr-4 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
              />
              <svg class="w-4 h-4 text-gray-400 absolute left-3 top-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
              </svg>
            </div>
          </div>

          <!-- Country Filter -->
          <div>
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">Country</label>
            <select id="dest-country-select" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50 cursor-pointer">
              <option value="all">All East Africa (Kenya, Tanzania & Uganda)</option>
              <option value="kenya">Kenya</option>
              <option value="tanzania">Tanzania</option>
              <option value="uganda">Uganda</option>
            </select>
          </div>

          <!-- Recommended Stay -->
          <div>
            <label class="block text-[11px] font-bold text-gray-500 uppercase tracking-wider mb-1">Recommended Stay</label>
            <select id="dest-stay-select" class="w-full px-3 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50 cursor-pointer">
              <option value="all">Any Stay Length</option>
              <option value="1">1 Day / Day Tour</option>
              <option value="2-3">2 – 3 Days</option>
              <option value="3-5">3 – 5 Days</option>
              <option value="6+">6+ Days (Mountain / Expeditions)</option>
            </select>
          </div>

        </div>

        <div class="mt-5 pt-4 border-t border-gray-100 flex items-center justify-between text-xs text-gray-500">
          <span id="dest-results-count" class="font-semibold text-gray-700">Showing {DESTINATIONS.length} Destinations</span>
          <button id="dest-reset-filters" type="button" class="text-[#0F6B38] hover:text-[#E86A17] font-bold hover:underline cursor-pointer">
            Reset Filters
          </button>
        </div>

      </div>
    </div>

    <!-- Destinations Grid -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div id="dest-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {DESTINATIONS.map((dest) => (
          <a
            href={`/destinations/${dest.slug}`}
            class="dest-item group relative rounded-3xl overflow-hidden shadow-lg hover:shadow-2xl transition-all duration-500 h-[440px] flex flex-col justify-end p-6 border border-gray-100"
            data-name={dest.name.toLowerCase()}
            data-country={dest.country.toLowerCase()}
            data-stay={dest.recommendedDays}
            data-wildlife={dest.wildlifeHighlights.join(" ").toLowerCase()}
          >
            <!-- Background Image -->
            <img
              src={dest.heroImage}
              alt={dest.name}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#121814] via-[#121814]/60 to-black/20 group-hover:via-[#121814]/70 transition-colors"></div>

            <!-- Top Badges -->
            <div class="absolute top-4 left-4 flex gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#0F6B38] text-white shadow-xs">
                {dest.country}
              </span>
            </div>

            <div class="absolute top-4 right-4">
              <span class="px-3 py-1 rounded-full text-xs font-semibold bg-black/40 text-white/90 backdrop-blur-xs">
                ⏱ {dest.recommendedDays}
              </span>
            </div>

            <!-- Content Details -->
            <div class="relative z-10 text-white">
              <span class="text-xs uppercase tracking-widest text-[#FFAE19] font-bold">
                {dest.tagline}
              </span>
              <h3 class="text-2xl sm:text-3xl font-bold font-serif-luxury mt-1 group-hover:text-[#FFAE19] transition-colors">
                {dest.name}
              </h3>
              <p class="text-xs sm:text-sm text-slate-300 mt-2 line-clamp-2 leading-relaxed font-light">
                {dest.overview}
              </p>

              <!-- Wildlife pills -->
              <div class="mt-4 flex flex-wrap gap-1.5">
                {dest.wildlifeHighlights.slice(0, 3).map((w) => (
                  <span class="text-[11px] font-medium px-2 py-0.5 rounded-md bg-white/15 text-slate-200">
                    🐾 {w}
                  </span>
                ))}
              </div>

              <div class="mt-5 pt-4 border-t border-white/15 flex items-center justify-between text-xs font-bold text-[#FFAE19] group-hover:text-white transition-colors">
                <span>View Wildlife & Safari Itineraries</span>
                <span class="transform group-hover:translate-x-1.5 transition-transform">→</span>
              </div>
            </div>
          </a>
        ))}
      </div>

      <!-- Empty State -->
      <div id="dest-no-results" class="hidden text-center py-20 bg-white rounded-3xl border border-gray-100 p-8">
        <div class="text-4xl mb-3">🌍</div>
        <h3 class="text-2xl font-bold font-serif-luxury text-[#1E2621]">No Destinations Found</h3>
        <p class="text-sm text-gray-600 mt-2 max-w-md mx-auto">
          We couldn't find any parks matching your search. Clear your filters or ask our guides for a custom wilderness route.
        </p>
        <button id="dest-reset-empty" type="button" class="mt-6 px-6 py-2.5 rounded-full bg-[#0F6B38] text-white text-xs font-bold hover:bg-[#094423]">
          Clear All Filters
        </button>
      </div>

      <!-- Expert Help Banner -->
      <div class="mt-16 p-8 sm:p-12 rounded-3xl bg-gradient-to-r from-[#094423] to-[#0F6B38] text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-2xl">
        <div>
          <span class="text-xs uppercase tracking-wider text-[#FFAE19] font-bold">Unsure Where to Go?</span>
          <h3 class="text-2xl sm:text-3xl font-bold font-serif-luxury mt-1">Talk to a Native Safari Guide</h3>
          <p class="text-sm text-slate-200 mt-1 max-w-xl font-light">
            Tell us your travel month and whether you want big cats, elephants, great migration, or beaches. We will pick the exact right park combinations.
          </p>
        </div>
        <a
          href="https://wa.me/254700000000"
          target="_blank"
          rel="noopener noreferrer"
          class="shrink-0 px-8 py-3.5 rounded-full text-sm font-bold bg-[#25D366] text-white hover:brightness-105 shadow-md transition-all active:scale-95 flex items-center gap-2"
        >
          <span>Chat on WhatsApp</span>
        </a>
      </div>

    </div>

  </main>

  <Footer />
</Layout>

<script>
  const searchInput = document.getElementById('dest-search-input') as HTMLInputElement;
  const countrySelect = document.getElementById('dest-country-select') as HTMLSelectElement;
  const staySelect = document.getElementById('dest-stay-select') as HTMLSelectElement;
  const resetBtn = document.getElementById('dest-reset-filters') as HTMLButtonElement;
  const resetEmptyBtn = document.getElementById('dest-reset-empty') as HTMLButtonElement;
  const resultsCount = document.getElementById('dest-results-count') as HTMLElement;
  const noResults = document.getElementById('dest-no-results') as HTMLElement;
  const items = Array.from(document.querySelectorAll('.dest-item')) as HTMLElement[];

  function filterDestinations() {
    const query = searchInput.value.toLowerCase().trim();
    const country = countrySelect.value;
    const stay = staySelect.value;

    let visibleCount = 0;

    items.forEach(item => {
      const name = item.getAttribute('data-name') || '';
      const c = item.getAttribute('data-country') || '';
      const s = item.getAttribute('data-stay') || '';
      const wildlife = item.getAttribute('data-wildlife') || '';

      const matchesQuery = !query || name.includes(query) || wildlife.includes(query);
      const matchesCountry = country === 'all' || c === country;
      let matchesStay = true;
      if (stay === '1') matchesStay = s.includes('1');
      else if (stay === '2-3') matchesStay = s.includes('2') || s.includes('3');
      else if (stay === '3-5') matchesStay = s.includes('3') || s.includes('4') || s.includes('5');
      else if (stay === '6+') matchesStay = s.includes('6') || s.includes('7') || s.includes('8') || s.includes('9');

      if (matchesQuery && matchesCountry && matchesStay) {
        item.style.display = 'flex';
        visibleCount++;
      } else {
        item.style.display = 'none';
      }
    });

    resultsCount.textContent = `Showing ${visibleCount} of ${items.length} Destinations`;

    if (visibleCount === 0) {
      noResults.classList.remove('hidden');
    } else {
      noResults.classList.add('hidden');
    }
  }

  function resetAll() {
    searchInput.value = '';
    countrySelect.value = 'all';
    staySelect.value = 'all';
    filterDestinations();
  }

  searchInput.addEventListener('input', filterDestinations);
  countrySelect.addEventListener('change', filterDestinations);
  staySelect.addEventListener('change', filterDestinations);
  resetBtn.addEventListener('click', resetAll);
  resetEmptyBtn?.addEventListener('click', resetAll);
</script>
