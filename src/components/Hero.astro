---
---

<section class="relative min-h-[85vh] sm:min-h-[90vh] flex items-center justify-center overflow-hidden">
  <!-- Hero Background Image & Gradient Overlays -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Masai_Mara_at_Sunset.jpg/1280px-Masai_Mara_at_Sunset.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"
      alt="African Safari Sunset Savannah with Acacia and Wildlife in Masai Mara"
      class="w-full h-full object-cover object-center scale-105"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Brand Sunset & Night Gradient Overlays -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#094423]/90 via-[#121814]/60 to-[#121814]/40 mix-blend-multiply"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#121814]/80 via-transparent to-[#121814]/70"></div>
    <!-- Warm amber golden bottom rim -->
    <div class="absolute bottom-0 inset-x-0 h-20 bg-gradient-to-t from-[#FDFBF7] to-transparent"></div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-20 text-center flex flex-col items-center">
    
    <!-- Top Pill Badge -->
    <div class="inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 rounded-full bg-white/15 backdrop-blur-md border border-white/30 text-white text-xs sm:text-sm font-semibold mb-4 sm:mb-6 shadow-sm">
      <span class="w-2 h-2 rounded-full bg-[#FFAE19] animate-pulse"></span>
      <span class="text-[#FFAE19]">★ 4.9/5 Star Rated</span>
      <span class="text-white/80">|</span>
      <span>Authentic East Africa Safaris</span>
    </div>

    <!-- Main Hero Headline -->
    <h1 class="text-3xl sm:text-5xl lg:text-7xl font-bold text-white tracking-tight leading-tight max-w-4xl drop-shadow-md">
      Journey Into The <br />
      <span class="bg-gradient-to-r from-[#FFAE19] via-[#FFC043] to-[#F38218] bg-clip-text text-transparent italic">
        Untamed Heart
      </span> <br class="sm:hidden" />
      Of Africa
    </h1>

    <!-- Subtitle -->
    <p class="mt-4 sm:mt-6 text-sm sm:text-xl text-slate-200 max-w-2xl font-normal leading-relaxed drop-shadow px-2">
      Bespoke wildlife safaris, Great Migration river crossings, and luxury eco-camps crafted with deep African soul, personal touch, and expert care.
    </p>

    <!-- Quick Safari Finder Widget (Mobile Responsive) -->
    <div class="mt-8 sm:mt-10 w-full max-w-4xl bg-white/95 backdrop-blur-md rounded-2xl sm:rounded-full p-3 sm:p-2.5 shadow-2xl border border-white/40">
      <form id="safari-search-form" class="grid grid-cols-1 sm:grid-cols-4 gap-2.5 sm:gap-2 items-center" onsubmit="event.preventDefault(); window.location.href='/safaris';">
        
        <!-- Destination -->
        <div class="flex items-center px-3 sm:px-4 py-2 bg-gray-50/80 sm:bg-transparent rounded-xl sm:rounded-none border-b sm:border-b-0 sm:border-r border-gray-200">
          <div class="text-left w-full">
            <label class="block text-[10px] uppercase font-bold tracking-wider text-gray-500">Destination</label>
            <select class="w-full bg-transparent text-xs sm:text-sm font-bold text-[#1E2621] focus:outline-none cursor-pointer">
              <option value="all">All East Africa</option>
              <option value="masai-mara">Masai Mara (Kenya)</option>
              <option value="serengeti">Serengeti (Tanzania)</option>
              <option value="bwindi">Bwindi Gorillas (Uganda)</option>
              <option value="amboseli">Amboseli (Mt. Kilimanjaro)</option>
              <option value="tsavo">Tsavo & Diani Beach</option>
              <option value="samburu">Samburu & Ol Pejeta</option>
            </select>
          </div>
        </div>

        <!-- Safari Style -->
        <div class="flex items-center px-3 sm:px-4 py-2 bg-gray-50/80 sm:bg-transparent rounded-xl sm:rounded-none border-b sm:border-b-0 sm:border-r border-gray-200">
          <div class="text-left w-full">
            <label class="block text-[10px] uppercase font-bold tracking-wider text-gray-500">Safari Style</label>
            <select class="w-full bg-transparent text-xs sm:text-sm font-bold text-[#1E2621] focus:outline-none cursor-pointer">
              <option value="great-migration">Great Migration</option>
              <option value="luxury-lodges">Luxury Tented Camps</option>
              <option value="gorilla">Gorilla Trekking</option>
              <option value="bush-beach">Bush to Beach</option>
              <option value="kilimanjaro">Kilimanjaro Trekking</option>
              <option value="family">Family Safari</option>
            </select>
          </div>
        </div>

        <!-- Duration -->
        <div class="flex items-center px-3 sm:px-4 py-2 bg-gray-50/80 sm:bg-transparent rounded-xl sm:rounded-none">
          <div class="text-left w-full">
            <label class="block text-[10px] uppercase font-bold tracking-wider text-gray-500">Duration</label>
            <select class="w-full bg-transparent text-xs sm:text-sm font-bold text-[#1E2621] focus:outline-none cursor-pointer">
              <option value="3-4">3 - 4 Days</option>
              <option value="5-7" selected>5 - 7 Days (Popular)</option>
              <option value="8-10">8 - 10 Days</option>
              <option value="11+">11+ Days (Grand Tour)</option>
            </select>
          </div>
        </div>

        <!-- Submit Button -->
        <button
          type="submit"
          class="w-full py-3 sm:py-3.5 px-6 rounded-xl sm:rounded-full bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] text-white font-bold text-sm shadow-md hover:shadow-lg hover:brightness-105 active:scale-98 transition-all flex items-center justify-center gap-2 cursor-pointer"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
          </svg>
          <span>Find Safaris</span>
        </button>

      </form>
    </div>

    <!-- Quick Highlights -->
    <div class="mt-6 sm:mt-8 flex flex-wrap justify-center items-center gap-3 sm:gap-6 text-xs sm:text-sm text-white/90 font-medium">
      <div class="flex items-center gap-1.5 sm:gap-2">
        <svg class="w-4 h-4 text-[#FFAE19] shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>100% Tailor-Made Private Itineraries</span>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2">
        <svg class="w-4 h-4 text-[#FFAE19] shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>Window Seats in 4x4 Land Cruisers</span>
      </div>
      <div class="flex items-center gap-1.5 sm:gap-2">
        <svg class="w-4 h-4 text-[#FFAE19] shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
        </svg>
        <span>24/7 In-Country Concierge</span>
      </div>
    </div>

  </div>
</section>
