---
---

<section class="relative min-h-[75vh] sm:min-h-[85vh] flex items-center justify-center overflow-hidden">
  <!-- Cinematic Savannah Sunset Background -->
  <div class="absolute inset-0 z-0">
    <img
      src="https://thumb.wikimedia.org/wikipedia/commons/thumb/1/17/Masai_Mara_at_Sunset.jpg/1280px-Masai_Mara_at_Sunset.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail"
      alt="Masai Mara Sunset Savannah"
      class="w-full h-full object-cover object-center"
      loading="eager"
      fetchpriority="high"
    />
    <!-- Subtle dark gradient for contrast -->
    <div class="absolute inset-0 bg-black/45 sm:bg-black/40"></div>
    <div class="absolute bottom-0 inset-x-0 h-24 bg-gradient-to-t from-[#FDFBF7] to-transparent"></div>
  </div>

  <!-- Minimal Hero Content -->
  <div class="relative z-10 max-w-4xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center">
    
    <span class="inline-block px-3.5 py-1 rounded-full bg-white/15 backdrop-blur-md border border-white/25 text-[#FFAE19] text-xs font-semibold tracking-widest uppercase mb-4 sm:mb-6">
      Private East Africa Safaris
    </span>

    <h1 class="text-4xl sm:text-7xl font-extrabold text-white tracking-tight leading-[1.1] drop-shadow-md">
      Untamed Africa. <br />
      <span class="bg-gradient-to-r from-[#FFAE19] via-[#FFC043] to-[#F38218] bg-clip-text text-transparent italic">
        Pure Wonder.
      </span>
    </h1>

    <p class="mt-4 sm:mt-5 text-base sm:text-xl text-slate-200 font-light max-w-xl leading-relaxed drop-shadow">
      Bespoke private wildlife expeditions across Kenya, Tanzania, and Uganda.
    </p>

    <!-- Clean Action Buttons -->
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/safaris"
        class="px-7 py-3 rounded-full bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] text-white font-bold text-sm shadow-lg hover:brightness-105 active:scale-95 transition-all"
      >
        View Safari Packages
      </a>
      <a
        href="#inquiry"
        class="px-7 py-3 rounded-full bg-white/15 backdrop-blur-md border border-white/30 text-white font-bold text-sm hover:bg-white hover:text-[#094423] active:scale-95 transition-all"
      >
        Plan Custom Trip
      </a>
    </div>

  </div>
</section>
