---
---

<section id="inquiry" class="py-20 relative bg-gradient-to-br from-[#094423] via-[#0F6B38] to-[#121814] text-white overflow-hidden">
  
  <!-- Subtle Background Pattern / Wildlife Accent -->
  <div class="absolute -right-20 -bottom-20 w-96 h-96 rounded-full bg-[#FFAE19]/10 blur-3xl pointer-events-none"></div>
  <div class="absolute -left-20 -top-20 w-96 h-96 rounded-full bg-[#E86A17]/10 blur-3xl pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Left Column: Compelling Pitch & Contact Points -->
      <div class="lg:col-span-5">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 backdrop-blur-xs text-[#FFAE19] text-xs font-bold uppercase tracking-wider mb-4 border border-white/20">
          <span>Start Your Adventure</span>
        </div>
        
        <h2 class="text-3xl sm:text-5xl font-bold tracking-tight leading-tight">
          Let’s Craft Your <br />
          <span class="text-[#FFAE19] font-script-bliss text-4xl sm:text-6xl">Dream African Safari</span>
        </h2>

        <p class="mt-4 text-base text-slate-200 leading-relaxed font-light">
          No two safaris should be identical. Tell us what you envision, whether it's hearing lions roar at dusk or floating in a hot air balloon over the Mara plains.
        </p>

        <!-- Value Bullets -->
        <div class="mt-8 space-y-4">
          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-[#FFAE19]/20 flex items-center justify-center shrink-0 mt-0.5 text-[#FFAE19]">
              ✓
            </div>
            <div>
              <div class="font-bold text-sm text-white">Free Custom Itinerary in 24 Hours</div>
              <div class="text-xs text-slate-300">Detailed day-by-day plan with lodge options and transparent pricing.</div>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-[#FFAE19]/20 flex items-center justify-center shrink-0 mt-0.5 text-[#FFAE19]">
              ✓
            </div>
            <div>
              <div class="font-bold text-sm text-white">Zero Obligation & Flexible Dates</div>
              <div class="text-xs text-slate-300">Modify any detail until it fits your budget and desires perfectly.</div>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <div class="w-8 h-8 rounded-full bg-[#FFAE19]/20 flex items-center justify-center shrink-0 mt-0.5 text-[#FFAE19]">
              ✓
            </div>
            <div>
              <div class="font-bold text-sm text-white">Direct Guide Communication</div>
              <div class="text-xs text-slate-300">Speak directly with our native safari directors via WhatsApp or phone call.</div>
            </div>
          </div>
        </div>

        <!-- Direct Support info -->
        <div class="mt-10 p-5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15">
          <div class="text-xs text-slate-300 font-medium">Prefer to talk directly right now?</div>
          <div class="mt-2 flex flex-wrap items-center gap-4">
            <a
              href="https://wa.me/254700000000"
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-[#25D366] text-white text-xs font-bold hover:brightness-110 transition-all shadow-md"
            >
              <span>WhatsApp Safari Specialist</span>
            </a>
            <a
              href="tel:+254700000000"
              class="text-xs font-bold text-[#FFAE19] hover:underline"
            >
              Call: +254 700 000 000
            </a>
          </div>
        </div>
      </div>

      <!-- Right Column: Interactive Form -->
      <div class="lg:col-span-7">
        <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-2xl text-gray-800">
          
          <h3 class="text-2xl font-bold text-[#094423]">
            Customize Your Safari Itinerary
          </h3>
          <p class="text-xs sm:text-sm text-gray-500 mt-1">
            Fill in your preferred details and our head safari designer will respond within 24 hours.
          </p>

          <form id="safari-inquiry-form" class="mt-6 space-y-4">
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Your Full Name *</label>
                <input
                  type="text"
                  required
                  placeholder="e.g. Sarah Jenkins"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Email Address *</label>
                <input
                  type="email"
                  required
                  placeholder="name@example.com"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50"
                />
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Phone / WhatsApp *</label>
                <input
                  type="tel"
                  required
                  placeholder="+1 (555) 000-0000"
                  class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50"
                />
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Estimated Travel Month / Year</label>
                <select class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50 cursor-pointer">
                  <option value="jul-oct-2026">July - October 2026 (Great Migration Peak)</option>
                  <option value="nov-dec-2026">November - December 2026 (Festive Season)</option>
                  <option value="jan-mar-2027">January - March 2027 (Calving Season)</option>
                  <option value="apr-jun-2027">April - June 2027 (Green Season / Best Value)</option>
                  <option value="flexible">I am flexible / Exploring options</option>
                </select>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Estimated Group Size</label>
                <select class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50 cursor-pointer">
                  <option value="couple">2 Adults (Couple / Honeymoon)</option>
                  <option value="family">Family with Children</option>
                  <option value="small-group">Small Group (3-6 Travelers)</option>
                  <option value="large-group">Large Group (7+ Travelers)</option>
                  <option value="solo">Solo Traveler</option>
                </select>
              </div>

              <div>
                <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">Accommodation Tier</label>
                <select class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50 cursor-pointer">
                  <option value="luxury">Luxury & Boutique Tented Lodges</option>
                  <option value="mid-range" selected>Mid-Range Classic Safari Camps</option>
                  <option value="ultra-luxury">Ultra-Luxury / 5-Star Exclusive</option>
                  <option value="budget">Comfortable Budget Camping</option>
                </select>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                Destinations or Experiences of Interest
              </label>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 text-xs text-gray-700">
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" checked class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Masai Mara</span>
                </label>
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" checked class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Amboseli</span>
                </label>
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Serengeti</span>
                </label>
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Diani Beach</span>
                </label>
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Hot Air Balloon</span>
                </label>
                <label class="flex items-center gap-1.5 p-2 rounded-lg bg-gray-50 border border-gray-200 cursor-pointer hover:bg-gray-100">
                  <input type="checkbox" class="rounded text-[#0F6B38] focus:ring-[#0F6B38]" />
                  <span>Samburu</span>
                </label>
              </div>
            </div>

            <div>
              <label class="block text-xs font-bold text-gray-700 uppercase tracking-wider mb-1">
                Special Requests or Must-See Animals
              </label>
              <textarea
                rows="3"
                placeholder="e.g. We would love to celebrate a birthday with a hot air balloon flight and see the rhino sanctuary..."
                class="w-full px-4 py-3 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50/50"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-4 rounded-full bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] text-white font-bold text-base shadow-xl hover:shadow-2xl hover:brightness-105 active:scale-98 transition-all flex items-center justify-center gap-2"
            >
              <span>Submit Safari Inquiry (100% Free)</span>
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>

            <!-- Success notification container -->
            <div id="form-success" class="hidden p-4 rounded-xl bg-green-50 border border-green-200 text-green-800 text-sm text-center font-medium">
              🎉 Asante Sana! Your safari inquiry has been received. Our senior safari consultant will email you a tailored itinerary within 24 hours.
            </div>

          </form>

        </div>
      </div>

    </div>
  </div>
</section>

<script>
  const form = document.getElementById('safari-inquiry-form');
  const successBox = document.getElementById('form-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successBox.classList.remove('hidden');
      form.querySelector('button[type="submit"]')?.setAttribute('disabled', 'true');
      (form.querySelector('button[type="submit"]') as HTMLElement)?.classList.add('opacity-50', 'cursor-not-allowed');
    });
  }
</script>
