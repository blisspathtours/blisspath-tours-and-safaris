---
---

<section id="inquiry" class="py-20 bg-gradient-to-br from-[#094423] to-[#0F6B38] text-white">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center mb-10">
      <span class="inline-block px-3 py-1 rounded-full bg-white/10 text-[#FFAE19] text-xs font-bold uppercase tracking-widest mb-3 border border-white/20">
        Bespoke Planning
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold tracking-tight">
        Plan Your Custom <span class="text-[#FFAE19]">Safari</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-slate-200 font-light max-w-lg mx-auto">
        Tell us your dream travel dates, preferred destinations, or group size. We will design your personalized itinerary within 24 hours.
      </p>
    </div>

    <!-- Clean, Streamlined Form -->
    <div class="bg-white rounded-3xl p-6 sm:p-10 shadow-2xl text-gray-800">
      <form id="safari-inquiry-form" class="space-y-4">
        
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
          <div>
            <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">Full Name *</label>
            <input
              type="text"
              required
              placeholder="e.g. Sarah Jenkins"
              class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">Email Address *</label>
            <input
              type="email"
              required
              placeholder="sarah@example.com"
              class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
            />
          </div>

          <div>
            <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">WhatsApp / Phone *</label>
            <input
              type="tel"
              required
              placeholder="+1 (555) 000-0000"
              class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
            />
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          <div>
            <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">Primary Destination</label>
            <select class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50 cursor-pointer">
              <option value="masai-mara">Masai Mara (Kenya)</option>
              <option value="serengeti">Serengeti & Ngorongoro (Tanzania)</option>
              <option value="bwindi">Bwindi Gorillas (Uganda)</option>
              <option value="kenya-tanzania">Kenya & Tanzania Circuit</option>
              <option value="bush-beach">Bush to Beach (Safari + Ocean)</option>
              <option value="custom">Not sure / Help me decide</option>
            </select>
          </div>

          <div>
            <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">Travel Timing</label>
            <select class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50 cursor-pointer">
              <option value="jul-oct-2026">July – October 2026 (Great Migration Peak)</option>
              <option value="nov-dec-2026">November – December 2026 (Festive Season)</option>
              <option value="jan-mar-2027">January – March 2027 (Calving Season)</option>
              <option value="apr-jun-2027">April – June 2027 (Green Season)</option>
              <option value="flexible">Flexible / Planning ahead</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-[11px] font-bold text-gray-600 uppercase tracking-wider mb-1">
            Trip Notes or Special Requests (Optional)
          </label>
          <textarea
            rows="2"
            placeholder="e.g. 2 adults, 2 kids, interested in balloon safari..."
            class="w-full px-3.5 py-2.5 rounded-xl border border-gray-200 text-sm focus:outline-none focus:ring-2 focus:ring-[#0F6B38] bg-gray-50"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3.5 rounded-full bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] text-white font-bold text-sm shadow-md hover:brightness-105 active:scale-98 transition-all cursor-pointer"
        >
          Request Free Custom Itinerary
        </button>

        <div id="form-success" class="hidden p-3.5 rounded-xl bg-green-50 border border-green-200 text-green-800 text-xs text-center font-medium">
          ✓ Asante Sana! We received your inquiry. Our senior safari consultant will email you within 24 hours.
        </div>

      </form>

      <!-- Quick WhatsApp Line -->
      <div class="mt-6 pt-5 border-t border-gray-100 flex flex-wrap items-center justify-between gap-3 text-xs text-gray-500">
        <span class="flex items-center gap-1.5 text-[#0F6B38] font-semibold">
          <span class="w-2 h-2 rounded-full bg-[#25D366]"></span>
          Direct line with native safari guides
        </span>

        <a
          href="https://wa.me/254700000000?text=Hello%20Bliss%20Path%20Safaris,%20I%20would%20like%20to%20plan%20a%20safari!"
          target="_blank"
          rel="noopener noreferrer"
          class="font-bold text-[#0F6B38] hover:text-[#E86A17] hover:underline"
        >
          Or Chat on WhatsApp →
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  const form = document.getElementById('safari-inquiry-form');
  const successBox = document.getElementById('form-success');
  if (form && successBox) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      successBox.classList.remove('hidden');
      const submitBtn = form.querySelector('button[type="submit"]');
      if (submitBtn) {
        submitBtn.setAttribute('disabled', 'true');
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
      }
    });
  }
</script>
