---
const pillars = [
  {
    number: "01",
    title: "Custom 4x4 Land Cruisers",
    desc: "Every safari vehicle features 360° pop-up photography roofs, high-lift suspension, camera charging inverters, and guaranteed window seats for every traveler."
  },
  {
    number: "02",
    title: "Native Naturalist Guides",
    desc: "Our guides are certified Gold & Silver by KPSGA. Born in the bush, their instinct for tracking wildlife turns good game drives into legendary encounters."
  },
  {
    number: "03",
    title: "100% Tailored & Private",
    desc: "No rushed group schedules. You decide when to take dawn game drives, how long to linger at lion prides, and when to celebrate sunset sundowners."
  }
];
---

<section id="why-us" class="py-20 bg-[#F5EFEB]/60">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold text-[#E86A17] uppercase tracking-widest block mb-2">
        The Bliss Path Difference
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1E2621] tracking-tight">
        Why Travel <span class="text-[#0F6B38]">With Us</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-gray-600 font-light leading-relaxed">
        We skip corporate tourist conveyer belts. Every journey is an intimate, private expedition into Africa’s raw beauty.
      </p>
    </div>

    <!-- Exactly 3 Minimal Pillars -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((item) => (
        <div class="bg-white p-8 rounded-3xl shadow-sm hover:shadow-lg transition-all duration-300 border border-gray-100 flex flex-col justify-between">
          <div>
            <span class="text-3xl font-extrabold text-[#FFAE19] block mb-4">
              {item.number}
            </span>
            <h3 class="text-xl font-bold text-[#1E2621] mb-2">
              {item.title}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed font-light">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-100 flex items-center gap-1.5 text-xs font-bold text-[#0F6B38]">
            <span>✓</span>
            <span>Standard on every Bliss Path safari</span>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
