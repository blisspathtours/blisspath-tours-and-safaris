---
const features = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />`,
    title: "Specially Outfitted 4x4 Land Cruisers",
    desc: "Every vehicle features a 360° pop-up photographic roof, guaranteed window seats, individual USB charging ports, and chilled water fridges."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z" />`,
    title: "Gold & Silver KPSGA Native Guides",
    desc: "Our naturalist guides have spent decades navigating the bush. Their instinct for wildlife behavior turns good game drives into legendary encounters."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />`,
    title: "100% Customized For You",
    desc: "No forced group paces. You choose how long to linger at a leopard kill, when to take sundowners, and your exact lodge luxury preferences."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
    title: "Community & Wildlife Conservation",
    desc: "Every journey with Bliss Path helps fund rural education for Maasai youth and local community-led anti-poaching ranger units."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4" />`,
    title: "Vetted Luxury Tented Camps & Lodges",
    desc: "We rigorously test every camp for culinary excellence, eco-sustainability, prime wildlife viewing location, and authentic African warmth."
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />`,
    title: "24/7 In-Country Concierge",
    desc: "From the second you step off the plane at Jomo Kenyatta Airport until your farewell flight, our local team is with you every step of the journey."
  }
];
---

<section id="why-us" class="py-20 bg-[#F5EFEB]/70">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title & Brand Story -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center mb-16">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F6B38]/10 text-[#0F6B38] text-xs font-bold uppercase tracking-wider mb-3">
          <span>The Bliss Path Difference</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold text-[#1E2621] tracking-tight">
          Crafting Safaris With <br />
          <span class="text-[#0F6B38] font-script-bliss text-4xl sm:text-6xl">Bliss, Passion & Soul</span>
        </h2>
        <p class="mt-4 text-gray-700 text-base sm:text-lg leading-relaxed">
          In Swahili, safari means "journey". At Bliss Path Tours & Safaris, we believe it should be a transformative expedition of wonder, connecting you with nature in its rawest, most breathtaking form.
        </p>
        <p class="mt-3 text-gray-600 text-sm leading-relaxed">
          Founded and operated by seasoned East African safari experts, we skip corporate tourist shortcuts. Every client gets their own dedicated safari vehicle, unlimited game drive mileage, and a guide who knows where the cubs are playing before anyone else.
        </p>
      </div>

      <!-- Brand Image Collage with Logo Badge -->
      <div class="relative">
        <div class="relative rounded-2xl overflow-hidden shadow-2xl border-4 border-white">
          <img
            src="https://upload.wikimedia.org/wikipedia/commons/f/fa/Elephants_at_Amboseli_national_park_against_Mount_Kilimanjaro.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"
            alt="Elephants grazing in Amboseli beneath Mount Kilimanjaro"
            class="w-full h-80 sm:h-96 object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          <div class="absolute bottom-6 left-6 right-6 text-white">
            <span class="text-xs uppercase tracking-widest text-[#FFAE19] font-bold">Uncompromising Quality</span>
            <p class="text-lg font-serif-luxury font-bold">"You haven't truly lived until you've watched sunrise over the Masai Mara."</p>
          </div>
        </div>

        <!-- Floating Badge -->
        <div class="absolute -bottom-6 -right-4 sm:-right-6 bg-white p-4 rounded-2xl shadow-xl border border-gray-100 flex items-center gap-3.5 max-w-xs">
          <img
            src="/images/logo.jpg"
            alt="Bliss Path Seal"
            class="w-12 h-12 rounded-full object-cover shrink-0 ring-2 ring-[#0F6B38]"
          />
          <div>
            <div class="text-xs font-bold text-[#0F6B38]">100% Local Outfitter</div>
            <div class="text-[11px] text-gray-500">Kenyan Owned & Operated with Global Standards</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {features.map((item, idx) => (
        <div class="bg-white p-8 rounded-2xl shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between group">
          <div>
            <div class="w-14 h-14 rounded-xl bg-[#0F6B38]/10 text-[#0F6B38] flex items-center justify-center mb-6 group-hover:bg-[#0F6B38] group-hover:text-white transition-colors duration-300">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={item.icon} />
            </div>
            <h3 class="text-xl font-bold text-[#1E2621] mb-2 group-hover:text-[#0F6B38] transition-colors">
              {item.title}
            </h3>
            <p class="text-sm text-gray-600 leading-relaxed">
              {item.desc}
            </p>
          </div>

          <div class="mt-6 pt-4 border-t border-gray-50 text-xs font-bold text-[#FFAE19] flex items-center gap-1">
            <span>Guaranteed on every booking</span>
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
            </svg>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
