---

<section class="relative z-20 -mt-8 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
  <div class="bg-white rounded-2xl shadow-xl border border-gray-100 p-6 sm:p-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-gray-100">
      
      <!-- Stat 1 -->
      <div class="pt-4 md:pt-0">
        <div class="flex items-center justify-center gap-1 text-3xl sm:text-4xl font-extrabold text-[#0F6B38]">
          <span>1,200</span><span class="text-[#E86A17]">+</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-gray-600 mt-1">Safaris Successfully Guided</p>
      </div>

      <!-- Stat 2 -->
      <div class="pt-4 md:pt-0">
        <div class="flex items-center justify-center gap-1 text-3xl sm:text-4xl font-extrabold text-[#0F6B38]">
          <span>4.9</span><span class="text-[#FFAE19]">★</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-gray-600 mt-1">TripAdvisor & Google Rating</p>
      </div>

      <!-- Stat 3 -->
      <div class="pt-4 md:pt-0">
        <div class="flex items-center justify-center gap-1 text-3xl sm:text-4xl font-extrabold text-[#0F6B38]">
          <span>100</span><span class="text-[#E86A17]">%</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-gray-600 mt-1">Tailored & Private Safaris</p>
      </div>

      <!-- Stat 4 -->
      <div class="pt-4 md:pt-0">
        <div class="flex items-center justify-center gap-1 text-3xl sm:text-4xl font-extrabold text-[#0F6B38]">
          <span>15</span><span class="text-[#FFAE19]">+</span>
        </div>
        <p class="text-xs sm:text-sm font-medium text-gray-600 mt-1">Years Local Bush Expertise</p>
      </div>

    </div>

    <!-- Partner badges bar -->
    <div class="mt-6 pt-6 border-t border-gray-100 flex flex-wrap items-center justify-between gap-4 text-xs font-semibold text-gray-500 uppercase tracking-wider">
      <span class="text-gray-400">Recognized & Licensed By:</span>
      <div class="flex flex-wrap items-center gap-6 text-gray-700">
        <span class="flex items-center gap-1.5 hover:text-[#0F6B38] transition-colors">
          <span class="w-2 h-2 rounded-full bg-[#0F6B38]"></span>
          Kenya Association of Tour Operators (KATO)
        </span>
        <span class="flex items-center gap-1.5 hover:text-[#0F6B38] transition-colors">
          <span class="w-2 h-2 rounded-full bg-[#0F6B38]"></span>
          Tourism Regulatory Authority (TRA)
        </span>
        <span class="flex items-center gap-1.5 hover:text-[#0F6B38] transition-colors">
          <span class="w-2 h-2 rounded-full bg-[#0F6B38]"></span>
          EcoTourism Kenya Certified
        </span>
        <span class="flex items-center gap-1.5 hover:text-[#0F6B38] transition-colors">
          <span class="w-2 h-2 rounded-full bg-[#FFAE19]"></span>
          Magical Kenya Partner
        </span>
      </div>
    </div>
  </div>
</section>
