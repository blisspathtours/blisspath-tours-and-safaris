---
---

<header class="w-full sticky top-0 z-50 bg-white/95 backdrop-blur-md shadow-xs transition-all duration-300">
  <!-- Top Announcement & Contact Bar -->
  <div class="bg-[#094423] text-white py-2.5 sm:py-3.5 px-4 sm:px-6 border-b border-[#0F6B38] shadow-xs">
    <div class="max-w-7xl mx-auto flex justify-between items-center">
      
      <!-- Mobile Layout: 2 Clean, Balanced Action Links (No wrapping or cut-offs) -->
      <div class="flex items-center justify-between w-full sm:w-auto sm:justify-start gap-4 sm:gap-7 text-xs sm:text-sm">
        <a href="tel:0741319503" class="flex items-center gap-2 hover:text-[#FFAE19] transition-colors py-0.5 group">
          <span class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center text-[#FFAE19] group-hover:bg-[#FFAE19] group-hover:text-[#094423] transition-colors shrink-0">
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
            </svg>
          </span>
          <span class="font-bold tracking-wide">0741319503</span>
        </a>

        <a href="https://wa.me/254741319503?text=Hello%20Bliss%20Path%20Safaris!" target="_blank" rel="noopener noreferrer" class="flex items-center gap-2 hover:text-[#FFAE19] transition-colors py-0.5 group">
          <span class="w-6 h-6 rounded-full bg-[#25D366]/20 flex items-center justify-center text-[#25D366] shrink-0">
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12.031 2a10.024 10.024 0 00-8.672 15.067L2 22l5.06-1.328A10.034 10.034 0 1012.031 2zm0 18.232c-1.802 0-3.513-.482-5.008-1.378l-.359-.214-3.003.788.802-2.928-.235-.374a8.214 8.214 0 117.803 4.106zm4.502-6.147c-.247-.123-1.463-.722-1.689-.804-.227-.083-.392-.123-.558.123s-.64.804-.784.969c-.144.165-.289.186-.536.062-.248-.124-1.046-.386-1.993-1.23-.737-.658-1.234-1.47-1.379-1.718-.144-.247-.015-.38.109-.504.111-.111.248-.289.371-.433.124-.144.165-.247.247-.412.083-.165.041-.31-.02-.433s-.558-1.344-.764-1.84c-.2-.485-.404-.42-.558-.427l-.475-.008c-.165 0-.433.062-.66.31-.227.247-.866.846-.866 2.064s.887 2.394 1.01 2.56c.124.165 1.745 2.664 4.227 3.737.59.256 1.052.408 1.411.523.593.188 1.133.162 1.56.098.476-.071 1.463-.598 1.669-1.176.206-.578.206-1.073.144-1.176-.062-.103-.227-.165-.474-.288z"/>
            </svg>
          </span>
          <span class="font-bold">WhatsApp 24/7</span>
        </a>

        <!-- Email: Desktop only -->
        <a href="mailto:info@blisspathtours.com" class="hidden md:flex items-center gap-1.5 hover:text-[#FFAE19] transition-colors">
          <svg class="w-3.5 h-3.5 text-[#FFAE19]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          <span>info@blisspathtours.com</span>
        </a>
      </div>

      <!-- Desktop Right: Migration Notice & Currencies -->
      <div class="hidden sm:flex items-center space-x-4 text-xs sm:text-sm">
        <a href="/migration-guide" class="hidden lg:inline text-[#FFAE19] font-medium tracking-wide hover:underline">
          🦁 Great Migration Season Calendar
        </a>
        <div class="flex items-center space-x-1.5 text-slate-300 font-medium">
          <span class="font-bold text-[#FFAE19]">USD ($)</span>
          <span>|</span>
          <span class="hover:text-white cursor-pointer transition-colors">EUR (€)</span>
          <span>|</span>
          <span class="hover:text-white cursor-pointer transition-colors">GBP (£)</span>
        </div>
      </div>

    </div>
  </div>

  <!-- Main Navigation Bar -->
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Brand Logo -->
      <a href="/" class="flex items-center gap-3.5 group">
        <img
          src="/images/logo.jpg"
          alt="Bliss Path Tours & Safaris Logo"
          class="w-14 h-14 rounded-full object-cover shadow-sm ring-2 ring-[#0F6B38] group-hover:scale-105 transition-transform duration-300"
        />
        <div class="flex flex-col">
          <span class="font-script-bliss text-3xl font-bold text-[#0F6B38] leading-none group-hover:text-[#E86A17] transition-colors">
            Bliss Path
          </span>
          <span class="text-xs uppercase tracking-[0.22em] text-[#E86A17] font-semibold font-sans mt-0.5">
            Tours & Safaris
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden lg:flex items-center space-x-5 text-sm font-semibold text-[#1E2621]">
        <a href="/destinations" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Destinations
        </a>
        <a href="/safaris" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Safaris
        </a>
        <a href="/hotels" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Hotels
        </a>
        <a href="/flights" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Flights
        </a>
        <a href="/migration-guide" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Migration
        </a>
        <a href="/blog" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Blog
        </a>
        <a href="/about" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          About Us
        </a>
        <a href="/contact" class="hover:text-[#0F6B38] transition-colors py-2 border-b-2 border-transparent hover:border-[#FFAE19]">
          Contact
        </a>
      </nav>

      <!-- Action Buttons -->
      <div class="hidden sm:flex items-center space-x-3">
        <a
          href="https://wa.me/254741319503?text=Hello%20Bliss%20Path%20Safaris,%20I%20would%20like%20to%20inquire%20about%20a%20safari!"
          target="_blank"
          rel="noopener noreferrer"
          class="p-2.5 rounded-full text-[#0F6B38] hover:bg-[#F5EFEB] border border-[#0F6B38]/30 transition-all hover:scale-105"
          title="Chat on WhatsApp: 0741319503"
        >
          <svg class="w-5 h-5 text-[#25D366]" fill="currentColor" viewBox="0 0 24 24">
            <path d="M12.031 2a10.024 10.024 0 00-8.672 15.067L2 22l5.06-1.328A10.034 10.034 0 1012.031 2zm0 18.232c-1.802 0-3.513-.482-5.008-1.378l-.359-.214-3.003.788.802-2.928-.235-.374a8.214 8.214 0 117.803 4.106zm4.502-6.147c-.247-.123-1.463-.722-1.689-.804-.227-.083-.392-.123-.558.123s-.64.804-.784.969c-.144.165-.289.186-.536.062-.248-.124-1.046-.386-1.993-1.23-.737-.658-1.234-1.47-1.379-1.718-.144-.247-.015-.38.109-.504.111-.111.248-.289.371-.433.124-.144.165-.247.247-.412.083-.165.041-.31-.02-.433s-.558-1.344-.764-1.84c-.2-.485-.404-.42-.558-.427l-.475-.008c-.165 0-.433.062-.66.31-.227.247-.866.846-.866 2.064s.887 2.394 1.01 2.56c.124.165 1.745 2.664 4.227 3.737.59.256 1.052.408 1.411.523.593.188 1.133.162 1.56.098.476-.071 1.463-.598 1.669-1.176.206-.578.206-1.073.144-1.176-.062-.103-.227-.165-.474-.288z"/>
          </svg>
        </a>

        <a
          href="/#inquiry"
          class="relative inline-flex items-center justify-center px-6 py-2.5 text-sm font-bold text-white transition-all bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] rounded-full shadow-md hover:shadow-lg hover:brightness-105 active:scale-95"
        >
          <span>Plan My Safari</span>
          <svg class="w-4 h-4 ml-2 -mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center">
        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 rounded-lg text-gray-700 hover:text-[#0F6B38] hover:bg-gray-100 focus:outline-none"
          aria-label="Toggle Navigation Menu"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Drawer Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-gray-200 px-4 pt-2 pb-6 space-y-3">
    <a href="/destinations" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Destinations
    </a>
    <a href="/safaris" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Safari Packages
    </a>
    <a href="/hotels" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Hotels & Lodges
    </a>
    <a href="/flights" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Safari Flights & Charters
    </a>
    <a href="/migration-guide" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Migration Calendar
    </a>
    <a href="/blog" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Safari Blog
    </a>
    <a href="/about" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      About Us
    </a>
    <a href="/contact" class="block px-3 py-2 rounded-md text-base font-medium text-gray-700 hover:text-[#0F6B38] hover:bg-gray-50">
      Contact & FAQ
    </a>
    <div class="pt-4 border-t border-gray-100 flex flex-col space-y-2">
      <a
        href="/#inquiry"
        class="w-full text-center py-3 text-sm font-bold text-white bg-gradient-to-r from-[#E86A17] via-[#F38218] to-[#FFAE19] rounded-full shadow-md"
      >
        Plan My Safari
      </a>
      <a
        href="https://wa.me/254741319503?text=Hello%20Bliss%20Path%20Safaris,%20I%20would%20like%20to%20inquire%20about%20a%20safari!"
        class="w-full text-center py-2.5 text-sm font-semibold text-[#0F6B38] border border-[#0F6B38] rounded-full hover:bg-green-50"
      >
        WhatsApp: 0741319503
      </a>
      <div class="pt-2 text-center text-xs text-gray-400">
        Currency: <span class="text-[#0F6B38] font-bold">USD ($)</span> | EUR (€) | GBP (£)
      </div>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });
    menu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
