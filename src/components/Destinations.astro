---
import { DESTINATIONS } from '../data/destinations';
---

<section id="destinations" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-12">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#E86A17]/10 text-[#E86A17] text-xs font-bold uppercase tracking-wider mb-3">
          <span>Iconic Safari Terrains</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-bold text-[#1E2621] tracking-tight">
          Explore East Africa's <span class="text-[#0F6B38]">Wild Wonderlands</span>
        </h2>
        <p class="mt-3 text-base text-gray-600 max-w-xl">
          From the legendary savannah plains of the Great Rift Valley to the idyllic turquoise shores of the Indian Ocean.
        </p>
      </div>

      <div class="mt-6 md:mt-0">
        <a
          href="#inquiry"
          class="inline-flex items-center gap-2 text-sm font-bold text-[#0F6B38] hover:text-[#E86A17] transition-colors"
        >
          <span>Need help choosing a destination? Talk to an expert</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>

    <!-- Destinations Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {DESTINATIONS.map((dest) => (
        <a
          href={`/destinations/${dest.slug}`}
          class="group relative rounded-2xl overflow-hidden shadow-lg h-96 cursor-pointer block"
        >
          <!-- Background Image -->
          <img
            src={dest.heroImage}
            alt={dest.name}
            class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
          />
          <!-- Multi-tier Gradient for rich readability -->
          <div class="absolute inset-0 bg-gradient-to-t from-[#121814] via-[#121814]/50 to-transparent opacity-85 group-hover:opacity-90 transition-opacity"></div>

          <!-- Top Badge -->
          <div class="absolute top-4 left-4 flex gap-2">
            <span class="px-3 py-1 rounded-full text-[11px] font-bold bg-[#0F6B38]/90 text-white backdrop-blur-xs border border-white/20">
              {dest.country}
            </span>
          </div>

          <div class="absolute top-4 right-4">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-black/40 text-white/90 backdrop-blur-xs">
              {dest.recommendedDays}
            </span>
          </div>

          <!-- Content overlay -->
          <div class="absolute bottom-0 inset-x-0 p-6 flex flex-col justify-end text-white">
            <span class="text-xs uppercase tracking-widest text-[#FFAE19] font-bold">
              {dest.tagline}
            </span>
            <h3 class="text-2xl font-bold font-serif-luxury mt-1 group-hover:text-[#FFAE19] transition-colors">
              {dest.name}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 line-clamp-2 leading-relaxed font-light">
              {dest.overview}
            </p>

            <div class="mt-4 pt-4 border-t border-white/15 flex items-center justify-between text-xs font-bold text-[#FFAE19] group-hover:text-white transition-colors">
              <span>Explore Destination & Lodges</span>
              <svg class="w-4 h-4 transform group-hover:translate-x-1.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
