---
import { DESTINATIONS } from '../data/destinations';

// Pick 3 premier iconic destinations for the landing page (1 Kenya, 1 Tanzania, 1 Uganda)
const featuredDestinations = [
  DESTINATIONS.find(d => d.slug === 'masai-mara') || DESTINATIONS[0],
  DESTINATIONS.find(d => d.slug === 'serengeti') || DESTINATIONS[1],
  DESTINATIONS.find(d => d.slug === 'bwindi-impenetrable') || DESTINATIONS[2]
];
---

<section id="destinations" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Title -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-bold text-[#E86A17] uppercase tracking-widest block mb-2">
          Wild Wonderlands
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1E2621] tracking-tight">
          Iconic <span class="text-[#0F6B38]">Destinations</span>
        </h2>
      </div>

      <a
        href="/destinations"
        class="mt-4 sm:mt-0 inline-flex items-center gap-1.5 text-sm font-bold text-[#0F6B38] hover:text-[#E86A17] transition-colors"
      >
        <span>View all 34 destinations</span>
        <span>→</span>
      </a>
    </div>

    <!-- Exactly 3 Destination Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredDestinations.map((dest) => (
        <a
          href={`/destinations/${dest.slug}`}
          class="group relative rounded-3xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-500 h-[420px] flex flex-col justify-end p-6 border border-gray-100 block"
        >
          <!-- Background Image -->
          <img
            src={dest.heroImage}
            alt={dest.name}
            class="absolute inset-0 w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#121814] via-[#121814]/50 to-transparent opacity-85 group-hover:opacity-90 transition-opacity"></div>

          <!-- Top Badge -->
          <div class="absolute top-4 left-4 flex gap-2">
            <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#0F6B38] text-white shadow-xs">
              {dest.country}
            </span>
          </div>

          <div class="absolute top-4 right-4">
            <span class="px-2.5 py-1 rounded-full text-xs font-semibold bg-black/40 text-white/90 backdrop-blur-xs">
              ⏱ {dest.recommendedDays}
            </span>
          </div>

          <!-- Content overlay -->
          <div class="relative z-10 text-white">
            <span class="text-xs uppercase tracking-widest text-[#FFAE19] font-bold">
              {dest.tagline}
            </span>
            <h3 class="text-2xl font-bold mt-1 group-hover:text-[#FFAE19] transition-colors">
              {dest.name}
            </h3>
            <p class="text-xs sm:text-sm text-slate-300 mt-2 line-clamp-2 leading-relaxed font-light">
              {dest.overview}
            </p>

            <div class="mt-4 pt-4 border-t border-white/15 flex items-center justify-between text-xs font-bold text-[#FFAE19] group-hover:text-white transition-colors">
              <span>Explore Destination</span>
              <span class="transform group-hover:translate-x-1.5 transition-transform">→</span>
            </div>
          </div>
        </a>
      ))}
    </div>

    <!-- Simple Bottom Link -->
    <div class="mt-12 text-center">
      <a
        href="/destinations"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white text-[#0F6B38] border-2 border-[#0F6B38] font-bold text-sm hover:bg-[#0F6B38] hover:text-white transition-all shadow-xs"
      >
        <span>Discover All 34 East Africa Parks & Reserves</span>
        <span class="ml-2">→</span>
      </a>
    </div>

  </div>
</section>
