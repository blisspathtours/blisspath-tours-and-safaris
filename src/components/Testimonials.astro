---
const reviews = [
  {
    name: "Dr. Sarah & James Miller",
    initials: "SM",
    location: "London, United Kingdom",
    safari: "7-Day Masai Mara & Amboseli Migration",
    quote: "Bliss Path made our 20th anniversary trip utterly unforgettable. Our guide, Joseph, possessed an uncanny sixth sense for wildlife. We saw a cheetah hunt on day two, four leopards, and the wildebeest crossing at the Mara river.",
    rating: 5
  },
  {
    name: "Michael & Karen Vance",
    initials: "MV",
    location: "California, USA",
    safari: "10-Day Kenya & Tanzania Grand Odyssey",
    quote: "From the prompt pickup in Nairobi to the champagne breakfast in the Serengeti, everything went like clockwork. The Land Cruiser was spotless and having charging ports for our camera gear was a lifesaver.",
    rating: 5
  },
  {
    name: "Elena Rostova",
    initials: "ER",
    location: "Zurich, Switzerland",
    safari: "6-Day Tsavo & Diani Bush to Beach",
    quote: "The combination of the red elephants of Tsavo and the serene turquoise waters of Diani Beach was pure perfection. The Bliss Path team took care of all park fees and domestic flights seamlessly.",
    rating: 5
  }
];
---

<section id="reviews" class="py-20 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <div class="text-center max-w-2xl mx-auto mb-14">
      <span class="text-xs font-bold text-[#E86A17] uppercase tracking-widest block mb-2">
        Verified Reviews
      </span>
      <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1E2621] tracking-tight">
        Traveler <span class="text-[#0F6B38]">Stories</span>
      </h2>
      <p class="mt-3 text-sm sm:text-base text-gray-600 font-light">
        Real stories from adventurers who explored the savannah with Bliss Path.
      </p>
    </div>

    <!-- 3 Testimonial Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {reviews.map((rev) => (
        <div class="bg-[#FDFBF7] p-8 rounded-3xl border border-gray-100 shadow-xs hover:shadow-md transition-shadow flex flex-col justify-between">
          <div>
            <div class="flex text-[#FFAE19] text-sm gap-1 mb-4">
              {"★".repeat(rev.rating)}
            </div>
            <p class="text-sm text-gray-700 leading-relaxed font-light italic">
              "{rev.quote}"
            </p>
          </div>

          <div class="mt-8 pt-5 border-t border-gray-200/60 flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-full bg-[#0F6B38] text-white flex items-center justify-center font-bold text-xs ring-2 ring-[#FFAE19] shrink-0">
              {rev.initials}
            </div>
            <div>
              <div class="font-bold text-sm text-[#1E2621]">{rev.name}</div>
              <div class="text-xs text-gray-500">{rev.location}</div>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>
