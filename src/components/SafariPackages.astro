---
import { SAFARI_PACKAGES } from '../data/safaris';

// Only select 3 premier signature safari packages for the landing page
const featuredPackages = [
  SAFARI_PACKAGES.find(p => p.id === 'masai-mara-migration') || SAFARI_PACKAGES[0],
  SAFARI_PACKAGES.find(p => p.id === 'tanzania-northern-circuit') || SAFARI_PACKAGES[1],
  SAFARI_PACKAGES.find(p => p.id === 'bwindi-gorilla-safari') || SAFARI_PACKAGES[2]
];
---

<section id="safaris" class="py-20 bg-[#FDFBF7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header (Clean & Minimal) -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between mb-12">
      <div>
        <span class="text-xs font-bold text-[#E86A17] uppercase tracking-widest block mb-2">
          Handcrafted Journeys
        </span>
        <h2 class="text-3xl sm:text-5xl font-extrabold text-[#1E2621] tracking-tight">
          Featured <span class="text-[#0F6B38]">Safaris</span>
        </h2>
      </div>
      <a
        href="/safaris"
        class="mt-4 sm:mt-0 inline-flex items-center gap-1.5 text-sm font-bold text-[#0F6B38] hover:text-[#E86A17] transition-colors"
      >
        <span>View all 14 packages</span>
        <span>→</span>
      </a>
    </div>

    <!-- Exactly 3 Featured Safari Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {featuredPackages.map((pkg) => (
        <div class="group bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-xl transition-all duration-300 border border-gray-100 flex flex-col justify-between">
          <!-- Card Image & Badge -->
          <div class="relative h-64 overflow-hidden">
            <a href={`/safaris/${pkg.slug}`} class="block w-full h-full">
              <img
                src={pkg.mainImage}
                alt={pkg.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent"></div>
            </a>

            <!-- Country & Duration Badges -->
            <div class="absolute top-4 left-4 flex gap-1.5">
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[#0F6B38] text-white shadow-xs">
                {pkg.country}
              </span>
              <span class="px-2.5 py-1 rounded-full text-xs font-bold bg-[#E86A17] text-white shadow-xs">
                {pkg.badge}
              </span>
            </div>

            <div class="absolute bottom-4 left-4 right-4 text-white text-xs">
              <span class="font-semibold block text-slate-200">⏱ {pkg.duration}</span>
              <span class="text-[11px] text-slate-300 truncate block mt-0.5">{pkg.destinations.join(" • ")}</span>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <a href={`/safaris/${pkg.slug}`}>
                <h3 class="text-xl font-bold text-[#1E2621] group-hover:text-[#0F6B38] transition-colors leading-snug">
                  {pkg.title}
                </h3>
              </a>

              <p class="mt-3 text-xs sm:text-sm text-gray-600 line-clamp-2 leading-relaxed font-light">
                {pkg.overview}
              </p>
            </div>

            <!-- Price & Link Button -->
            <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between">
              <div>
                <span class="block text-[10px] uppercase tracking-wider text-gray-400 font-bold">From</span>
                <span class="text-2xl font-black text-[#0F6B38]">${pkg.price} <span class="text-xs font-normal text-gray-500">/ pp</span></span>
              </div>

              <a
                href={`/safaris/${pkg.slug}`}
                class="px-5 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#E86A17] to-[#FFAE19] hover:brightness-105 active:scale-95 shadow-sm transition-all"
              >
                View Route →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Simple Bottom Link -->
    <div class="mt-12 text-center">
      <a
        href="/safaris"
        class="inline-flex items-center justify-center px-8 py-3.5 rounded-full bg-white text-[#0F6B38] border-2 border-[#0F6B38] font-bold text-sm hover:bg-[#0F6B38] hover:text-white transition-all shadow-xs"
      >
        <span>Explore All 14 Safari Packages</span>
        <span class="ml-2">→</span>
      </a>
    </div>

  </div>
</section>
