---
import { SAFARI_PACKAGES } from '../data/safaris';
---

<section id="safaris" class="py-20 bg-[#FDFBF7]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#0F6B38]/10 text-[#0F6B38] text-xs font-bold uppercase tracking-wider mb-3">
        <span>Handcrafted Itineraries</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-bold text-[#1E2621] tracking-tight">
        Featured Safari <span class="text-[#0F6B38]">Packages</span>
      </h2>
      <p class="mt-4 text-base sm:text-lg text-gray-600">
        Every Bliss Path journey is fully customizable. Click into any tour to view its comprehensive day-by-day route, luxury lodge selections, and included game drives.
      </p>

      <!-- Category Filter Tabs -->
      <div class="mt-8 flex flex-wrap justify-center gap-2 sm:gap-3" id="package-filters">
        <button
          type="button"
          data-filter="all"
          class="filter-btn px-5 py-2 rounded-full text-sm font-bold transition-all bg-[#0F6B38] text-white shadow-sm cursor-pointer"
        >
          All Safaris
        </button>
        <button
          type="button"
          data-filter="migration"
          class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-white text-gray-700 hover:bg-[#F5EFEB] border border-gray-200 cursor-pointer"
        >
          Great Migration
        </button>
        <button
          type="button"
          data-filter="big-five"
          class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-white text-gray-700 hover:bg-[#F5EFEB] border border-gray-200 cursor-pointer"
        >
          Big Five & Amboseli
        </button>
        <button
          type="button"
          data-filter="luxury"
          class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-white text-gray-700 hover:bg-[#F5EFEB] border border-gray-200 cursor-pointer"
        >
          Luxury Tented
        </button>
        <button
          type="button"
          data-filter="bush-beach"
          class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-white text-gray-700 hover:bg-[#F5EFEB] border border-gray-200 cursor-pointer"
        >
          Bush & Beach
        </button>
        <button
          type="button"
          data-filter="day-tours"
          class="filter-btn px-5 py-2 rounded-full text-sm font-semibold transition-all bg-white text-gray-700 hover:bg-[#F5EFEB] border border-gray-200 cursor-pointer"
        >
          Day Excursions
        </button>
      </div>
    </div>

    <!-- Safari Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" id="packages-grid">
      {SAFARI_PACKAGES.map((pkg) => (
        <div
          data-category={pkg.category}
          class="package-card group bg-white rounded-2xl overflow-hidden shadow-md hover:shadow-2xl transition-all duration-300 border border-gray-100 flex flex-col justify-between"
        >
          <!-- Card Image & Badge -->
          <div class="relative h-64 overflow-hidden">
            <a href={`/safaris/${pkg.slug}`} class="block w-full h-full">
              <img
                src={pkg.mainImage}
                alt={pkg.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-black/20"></div>
            </a>

            <!-- Top Badges -->
            <div class="absolute top-4 left-4 flex gap-2">
              <span class="px-3 py-1 rounded-full text-xs font-bold bg-[#E86A17] text-white shadow-md">
                {pkg.badge}
              </span>
            </div>

            <div class="absolute top-4 right-4 bg-white/90 backdrop-blur-md px-2.5 py-1 rounded-full text-xs font-bold text-gray-800 flex items-center gap-1 shadow-sm">
              <span class="text-[#FFAE19]">★</span>
              <span>{pkg.rating}</span>
              <span class="text-gray-400 font-normal">({pkg.reviewsCount})</span>
            </div>

            <!-- Bottom Image Info -->
            <div class="absolute bottom-4 left-4 right-4">
              <span class="inline-block px-2.5 py-0.5 rounded-md bg-[#0F6B38] text-white text-xs font-semibold mb-1">
                ⏱ {pkg.duration}
              </span>
              <div class="text-xs text-slate-200 flex items-center gap-1">
                <svg class="w-3.5 h-3.5 text-[#FFAE19]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
                <span class="truncate">{pkg.destinations.join(" • ")}</span>
              </div>
            </div>
          </div>

          <!-- Card Content Body -->
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <a href={`/safaris/${pkg.slug}`}>
                <h3 class="text-xl font-bold text-[#1E2621] group-hover:text-[#0F6B38] transition-colors leading-snug">
                  {pkg.title}
                </h3>
              </a>

              <!-- Highlights list -->
              <ul class="mt-4 space-y-2 text-xs sm:text-sm text-gray-600">
                {pkg.highlights.slice(0, 3).map((h) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-[#0F6B38] shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="line-clamp-1">{h}</span>
                  </li>
                ))}
              </ul>
            </div>

            <!-- Price & Action Footer -->
            <div class="mt-6 pt-5 border-t border-gray-100 flex items-center justify-between">
              <div>
                <span class="block text-[11px] uppercase tracking-wider text-gray-400 font-semibold">From</span>
                <div class="flex items-baseline gap-1">
                  <span class="text-2xl font-black text-[#0F6B38]">${pkg.price}</span>
                  <span class="text-xs text-gray-500">/ person</span>
                </div>
              </div>

              <div class="flex items-center gap-2">
                <a
                  href={`/safaris/${pkg.slug}`}
                  class="inline-flex items-center justify-center px-4 py-2.5 rounded-full text-xs font-bold text-white bg-gradient-to-r from-[#E86A17] to-[#FFAE19] hover:brightness-105 active:scale-95 shadow-sm transition-all"
                >
                  View Itinerary →
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Bottom Custom Safari Note -->
    <div class="mt-14 p-6 sm:p-8 rounded-2xl bg-gradient-to-r from-[#094423] to-[#0F6B38] text-white flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xl">
      <div class="text-center sm:text-left">
        <h4 class="text-xl sm:text-2xl font-bold text-[#FFAE19]">Want a 100% Custom Private Safari?</h4>
        <p class="text-sm text-slate-200 mt-1">
          Tell us your dream dates, group size, and preferred camps. We design your personalized itinerary within 24 hours.
        </p>
      </div>
      <a
        href="#inquiry"
        class="shrink-0 px-6 py-3 rounded-full text-sm font-bold bg-[#FFAE19] text-[#094423] hover:bg-white hover:text-[#0F6B38] shadow-md transition-all active:scale-95"
      >
        Build Custom Safari
      </a>
    </div>

  </div>
</section>

<script>
  const filterButtons = document.querySelectorAll('.filter-btn');
  const cards = document.querySelectorAll('.package-card');

  filterButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      // update active styles
      filterButtons.forEach(b => {
        b.classList.remove('bg-[#0F6B38]', 'text-white', 'shadow-sm');
        b.classList.add('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      });
      btn.classList.remove('bg-white', 'text-gray-700', 'border', 'border-gray-200');
      btn.classList.add('bg-[#0F6B38]', 'text-white', 'shadow-sm');

      const filter = btn.getAttribute('data-filter');

      cards.forEach(card => {
        const cat = card.getAttribute('data-category');
        if (filter === 'all' || cat === filter) {
          (card as HTMLElement).style.display = 'flex';
        } else {
          (card as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
